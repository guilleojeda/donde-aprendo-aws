{
  "name": "donde-aprendo-aws",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "verify:blog": "node scripts/verify-blog.mjs && node scripts/verify-responsive-images.mjs",
    "verify:images": "node scripts/verify-responsive-images.mjs",
    "verify:site": "node scripts/verify-site.mjs && node --test tests/acceptance/site-themes.test.mjs tests/acceptance/compact-event-agenda.test.mjs tests/acceptance/compact-home.test.mjs tests/acceptance/compact-directories.test.mjs tests/acceptance/compact-blog.test.mjs tests/acceptance/compact-learning-paths.test.mjs tests/acceptance/certifications-overview.test.mjs tests/acceptance/certification-details.test.mjs",
    "verify:hosting": "node scripts/verify-amplify-hosting.mjs",
    "preview": "node scripts/preview.mjs",
    "verify:preview": "node --test tests/built-preview.mjs",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "package:submission": "node scripts/package-submission.mjs",
    "package:publication": "node scripts/package-publication.mjs",
    "package:password-reset": "node scripts/package-password-reset.mjs",
    "smoke:submission": "node scripts/smoke-submission-package.mjs",
    "import:catalog": "node scripts/import-catalog.mjs",
    "import:meetup-communities": "node scripts/import-meetup-communities.mjs",
    "package:meetup-events": "python3 scripts/package-meetup-events.py",
    "publish": "node scripts/publish.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-amplify": "3.1138.0",
    "@aws-sdk/client-dynamodb": "3.1138.0",
    "@aws-sdk/client-s3": "3.1138.0",
    "@aws-sdk/client-secrets-manager": "3.1138.0",
    "@aws-sdk/client-sts": "3.1138.0",
    "@aws-sdk/lib-dynamodb": "3.1138.0",
    "@aws-sdk/s3-presigned-post": "3.1138.0",
    "astro": "7.3.4",
    "astro-aws-amplify": "0.6.0",
    "csv-parse": "7.0.2",
    "google-auth-library": "11.3.1",
    "openid-client": "6.8.8",
    "sharp": "0.35.5",
    "twitter-text": "3.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
