---
import '../../styles/blog.css';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogHeader from '../../components/BlogHeader.astro';
import BlogFooter from '../../components/BlogFooter.astro';
import { loadSiteCatalog } from '../../lib/site-catalog.mjs';
import { LEARNING_PATHS, resolveLearningPaths, articlePathNavigation } from '../../lib/learning-paths.mjs';
import type { CatalogEvent, CatalogResource } from '../../types/catalog';

export async function getStaticPaths() {
  const [posts, catalog] = await Promise.all([getCollection('blog'), loadSiteCatalog()]);
  const resources = (catalog as Array<CatalogResource | CatalogEvent>)
    .filter((record): record is CatalogResource => record.recordType !== 'event');
  const paths = resolveLearningPaths(LEARNING_PATHS, resources, posts);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, pathNavigation: articlePathNavigation(paths, post.id) },
  }));
}

const { post, pathNavigation } = Astro.props;
const { Content } = await render(post);
const canonical = new URL(`/blog/${post.id}/`, Astro.site ?? Astro.url).href;
const publishedDate = new Intl.DateTimeFormat('es-AR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${post.data.publishedAt}T00:00:00Z`));
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonical={canonical}
  image={post.data.ogImage}
  imageAlt={post.data.ogImageAlt ?? post.data.coverAlt}
  publishedTimestamp={post.data.publishedTimestamp}
>
  <BlogHeader />
  <main class="blog-article">
    <header class="blog-article__header">
      <h1>{post.data.title}</h1>
      <p class="blog-article__date">Publicado el {publishedDate}</p>
    </header>
    <article class="blog-article__body">
      <Content />
    </article>
    {pathNavigation.length > 0 && (
      <nav class="blog-paths" aria-labelledby="blog-paths-title">
        <h2 id="blog-paths-title">Continuá tu recorrido</h2>
        <ul>
          {pathNavigation.map((path) => <li>
            <p>Este artículo forma parte de <strong>{path.title}</strong>.</p>
            <div class="blog-paths__actions">
              <a class="blog-paths__return" href={path.href} aria-label={`Volver al recorrido: ${path.title}`}>Volver al recorrido</a>
              {path.nextStep ? <a class="blog-paths__next" href={path.nextStep.href}>
                <span>Siguiente paso · {path.nextStep.label}</span>
                <strong>{path.nextStep.title}</strong>
              </a> : <p class="blog-paths__end">Llegaste al final de este recorrido.</p>}
            </div>
          </li>)}
        </ul>
      </nav>
    )}
    {post.data.related.length > 0 && (
      <section class="blog-related" aria-labelledby="blog-related-title">
        <div class="blog-related__header">
          <h2 id="blog-related-title">Seguí leyendo</h2>
          <a href="/blog/" aria-label="Volver al blog" class="blog-related__home">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 11.5 12 4l9 7.5M5.5 10.5V20h13v-9.5M9.5 20v-6h5v6" /></svg>
          </a>
        </div>
        <div class="blog-related__cards">
          {post.data.related.map((related) => (
            <a class="blog-related__card" href={related.url}>
              <img src={related.image} alt={related.imageAlt} loading="lazy" />
              <h3>{related.title}</h3>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
  <BlogFooter />
</BaseLayout>
