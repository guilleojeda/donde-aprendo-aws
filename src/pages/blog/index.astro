---
import '../../styles/blog.css';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogHeader from '../../components/BlogHeader.astro';
import BlogFooter from '../../components/BlogFooter.astro';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => post.data.indexOrder !== undefined)
  .sort((a, b) => a.data.indexOrder! - b.data.indexOrder!);
const archive = allPosts
  .filter((post) => post.data.indexOrder === undefined)
  .sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt) || a.data.title.localeCompare(b.data.title, 'es'));
const years = [...new Set(archive.map((post) => post.data.publishedAt.slice(0, 4)))];

if (posts.some((post, index) => post.data.indexOrder !== index + 1)) {
  throw new Error('Featured article positions must be unique and consecutive, starting at 1.');
}
---

<BaseLayout
  title="Guías y tutoriales AWS en español | Dónde Aprendo AWS"
  description="Explorá guías, tutoriales y recursos de AWS en español sobre fundamentos, certificaciones, arquitectura, seguridad y desarrollo."
  canonical="https://dondeaprendoaws.com/blog/"
>
  <BlogHeader />
  <main id="contenido" tabindex="-1" class="blog-index" aria-label="Artículos del blog">
    <header class="blog-index__intro">
      <h1>Guías y tutoriales AWS en español</h1>
      <p>El blog de Dónde Aprendo AWS reúne {allPosts.length} artículos sobre Amazon Web Services. Elegí una lectura destacada, <a href="#blog-archive-title">explorá el archivo por año</a> o <a href="/buscar/">buscá un tema</a>.</p>
      <nav class="blog-index__routes" aria-label="Leer con una ruta de aprendizaje">
        <span>¿Querés leer en orden?</span>
        <a href="/recorridos/primeros-pasos/">Primeros pasos</a>
        <a href="/recorridos/serverless/">Serverless</a>
        <a href="/recorridos/seguridad/">Seguridad</a>
        <a href="/recorridos/ia-generativa/">IA generativa</a>
      </nav>
    </header>
    <section aria-labelledby="blog-selected-title">
      <h2 id="blog-selected-title">Artículos destacados</h2>
      <div class="blog-index__cards">
        {posts.map((post) => (
          <a class="blog-card" href={`/blog/${post.id}/`}>
            <img src={post.data.cover} alt={post.data.coverAlt} loading={post.data.indexOrder === 1 ? 'eager' : 'lazy'} />
            <h3>{post.data.title}</h3>
          </a>
        ))}
      </div>
    </section>
    <section class="blog-archive" aria-labelledby="blog-archive-title">
      <h2 id="blog-archive-title">Archivo de artículos</h2>
      <p>Todos los demás artículos publicados, ordenados por fecha.</p>
      {years.map((year) => (
        <div class="blog-archive__year">
          <h3>{year}</h3>
          <ul>
            {archive.filter((post) => post.data.publishedAt.startsWith(year)).map((post) => (
              <li><a href={`/blog/${post.id}/`}>{post.data.title}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  </main>
  <BlogFooter />
</BaseLayout>
