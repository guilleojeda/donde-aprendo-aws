---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Directory from '../../components/Directory.astro';
import CollectionNavigation from '../../components/CollectionNavigation.astro';
import CollectionGuide from '../../components/CollectionGuide.astro';
import PageFactSummary from '../../components/PageFactSummary.astro';
import PageFaq from '../../components/PageFaq.astro';
import { loadSiteCatalog } from '../../lib/site-catalog.mjs';
import { communityCountryPages, communityCountryPath, eventCountryPath } from '../../lib/community-country-pages.mjs';
import { RESOURCE_COLLECTIONS } from '../../lib/resource-collections.mjs';
import { communityFactText, communityFormatSummary } from '../../lib/community-page-facts.mjs';
import { communityFaqItems } from '../../lib/page-faq-content.mjs';
import { COUNTRY_LABELS } from '../../lib/resource-discovery.mjs';
import type { CatalogEvent, CatalogResource } from '../../types/catalog';

export async function getStaticPaths() {
  const catalog = await loadSiteCatalog() as Array<CatalogResource | CatalogEvent>;
  const communities = catalog.filter((record): record is CatalogResource => record.recordType !== 'event' && record.kind === 'community');
  return communityCountryPages(communities).map(({ country, slug }) => ({
    params: { country: slug },
    props: { country },
  }));
}

const { country } = Astro.props;
const catalog = await loadSiteCatalog() as Array<CatalogResource | CatalogEvent>;
const allResources = catalog.filter((record): record is CatalogResource => record.recordType !== 'event');
const resources = allResources.filter((record) => record.kind === 'community' && record.country === country);
const events = catalog.filter((record): record is CatalogEvent => record.recordType === 'event');
const countryLabel = COUNTRY_LABELS[country as keyof typeof COUNTRY_LABELS];
const formatSummary = communityFormatSummary(resources);
const intro = `Conoce las comunidades AWS de ${countryLabel} y los temas que publican.`;
const title = `Comunidades AWS en ${countryLabel} | ¿Dónde Aprendo AWS?`;
const description = `Comunidades AWS en ${countryLabel}: ${formatSummary}. Conoce cada grupo y consulta sus enlaces para participar.`;
const communityCollections = RESOURCE_COLLECTIONS.filter((collection) => collection.kind === 'community');
const communityCollectionLinks = communityCollections.map(({ path, label }) => ({ path, label }));
const guide = {
  heading: `¿Qué tipos de comunidad AWS hay en ${countryLabel}?`,
  body: `Usa el filtro Formato para comparar los grupos publicados en ${countryLabel}; cada ficha muestra sus temas y enlaces disponibles.`,
  points: [
    ...(resources.some((resource) => resource.format === 'User Group') ? ['Los AWS User Groups reúnen a personas interesadas en compartir experiencias y aprender sobre AWS.'] : []),
    ...(resources.some((resource) => resource.format === 'Student Builder Group') ? ['Los Student Builder Groups son comunidades para aprender y construir con otros estudiantes.'] : []),
  ],
};
const agendaPath = eventCountryPath(country);
if (!agendaPath) throw new Error(`No event page path found for ${country}`);
const guideLinks = [
  ...communityCollections.map(({ path, label }) => ({ path, label })),
];
const faqItems = communityFaqItems({ countryName: countryLabel, agendaPath });
const path = communityCountryPath(country);
if (!path) throw new Error(`No community page path found for ${country}`);
const canonical = new URL(path, 'https://dondeaprendoaws.com').href;
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <SiteHeader />
  <Directory title={`Comunidades AWS en ${countryLabel}`} intro={intro} kind="community" resources={resources} allResources={allResources} events={events} country={country}>
    <div slot="before-filters" class="collection-page__editorial">
      <PageFactSummary text={communityFactText(resources, countryLabel)} label={`Resumen de comunidades en ${countryLabel}`} />
      <CollectionNavigation links={communityCollectionLinks} label="Tipos de comunidades AWS" />
    </div>
    <div slot="after-results" class="collection-page__after-results">
      <CollectionGuide guide={guide} links={guideLinks} />
      <PageFaq items={faqItems} id="community-country-faq" />
    </div>
  </Directory>
  <SiteFooter />
</BaseLayout>
