---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Directory from '../../components/Directory.astro';
import CollectionNavigation from '../../components/CollectionNavigation.astro';
import CollectionGuide from '../../components/CollectionGuide.astro';
import PageFactSummary from '../../components/PageFactSummary.astro';
import PageFaq from '../../components/PageFaq.astro';
import { RESOURCE_COLLECTIONS } from '../../lib/resource-collections.mjs';
import { communityFactText } from '../../lib/community-page-facts.mjs';
import { communityFaqItems } from '../../lib/page-faq-content.mjs';
import { loadSiteCatalog } from '../../lib/site-catalog.mjs';
import type { CatalogEvent, CatalogResource } from '../../types/catalog';

const catalog = await loadSiteCatalog() as Array<CatalogResource | CatalogEvent>;
const allResources = catalog.filter((record): record is CatalogResource => record.recordType !== 'event');
const resources = allResources.filter((record) => record.kind === 'community');
const events = catalog.filter((record): record is CatalogEvent => record.recordType === 'event');
const communityCollections = RESOURCE_COLLECTIONS.filter((collection) => collection.kind === 'community');
const communityCollectionLinks = communityCollections.map(({ path, label }) => ({ path, label }));
const guide = {
  heading: '¿Qué tipos de comunidad AWS hay?',
  body: 'Cada ficha indica el formato de la comunidad y muestra los temas y enlaces publicados para conocerla mejor.',
  points: [
    'Los AWS User Groups reúnen a personas interesadas en compartir experiencias y aprender sobre AWS.',
    'Los Student Builder Groups son espacios de comunidad orientados a estudiantes.',
  ],
};
const guideLinks = [
  ...communityCollections.map(({ path, label }) => ({ path, label })),
];
const faqItems = communityFaqItems();
---
<BaseLayout title="Comunidades AWS en Latinoamérica | ¿Dónde Aprendo AWS?" description="Explorá comunidades AWS en Latinoamérica por país y tipo de grupo. Conocé AWS User Groups y Student Builder Groups, y consultá sus enlaces para participar." canonical="https://dondeaprendoaws.com/comunidades/">
  <SiteHeader />
  <Directory title="Comunidades AWS en Latinoamérica" intro="Explorá comunidades AWS por país y tipo de grupo; consultá sus formatos, temas y enlaces disponibles." kind="community" resources={resources} allResources={allResources} events={events}>
    <div slot="before-filters" class="collection-page__editorial">
      <PageFactSummary text={communityFactText(resources)} label="Resumen de comunidades" />
      <CollectionNavigation links={communityCollectionLinks} label="Tipos de comunidades AWS" />
    </div>
    <div slot="after-results" class="collection-page__after-results">
      <CollectionGuide guide={guide} links={guideLinks} />
      <PageFaq items={faqItems} id="community-page-faq" />
    </div>
  </Directory>
  <SiteFooter />
</BaseLayout>
