---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Directory from '../../components/Directory.astro';
import CollectionNavigation from '../../components/CollectionNavigation.astro';
import CollectionGuide from '../../components/CollectionGuide.astro';
import { learningCollectionNavigation } from '../../lib/resource-collections.mjs';
import { loadSiteCatalog } from '../../lib/site-catalog.mjs';
import type { CatalogEvent, CatalogResource } from '../../types/catalog';

const catalog = await loadSiteCatalog() as Array<CatalogResource | CatalogEvent>;
const allResources = catalog.filter((record): record is CatalogResource => record.recordType !== 'event');
const resources = allResources.filter((record) => record.kind === 'content');
const events = catalog.filter((record): record is CatalogEvent => record.recordType === 'event');
const learningNavigation = learningCollectionNavigation('/aprender/');
const guide = {
  heading: 'Elige cómo quieres aprender AWS',
  body: 'Puedes empezar con un curso, resolver una duda con un tutorial o profundizar con una guía. Si todavía no tienes un tema en mente, los recorridos conectan artículos y recursos existentes en un orden para empezar.',
  points: [
    'Filtra los recursos por formato, tema y nivel para encontrar lo que necesitas.',
    'Revisa el destino, la fecha y los requisitos de cada publicación antes de seguir sus pasos.',
    'El catálogo enlaza material de terceros; las condiciones y la vigencia dependen de cada autor.',
  ],
};
const guideLinks = [{ path: '/recorridos/', label: 'Recorridos de aprendizaje' }];
---
<BaseLayout title="Recursos para aprender AWS en español | ¿Dónde Aprendo AWS?" description="Explora cursos, videos, artículos y recursos en español para aprender AWS por formato, tema y nivel." canonical="https://dondeaprendoaws.com/aprender/">
  <SiteHeader />
  <Directory title="Recursos para aprender AWS en español" intro="Encuentra cursos, videos y artículos para estudiar AWS a tu ritmo. Explora por formato, tema o nivel y elige recursos según lo que quieres aprender o construir." kind="content" resources={resources} allResources={allResources} events={events}>
    <div slot="before-filters" class="collection-page__editorial">
      <CollectionNavigation links={[]} learningNavigation={learningNavigation} />
    </div>
    <div slot="after-results" class="collection-page__after-results">
      <CollectionGuide guide={guide} links={guideLinks} />
    </div>
  </Directory>
  <SiteFooter />
</BaseLayout>
