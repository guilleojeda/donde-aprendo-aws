---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getCollection } from 'astro:content';
import { loadSiteCatalog } from '../../lib/site-catalog.mjs';
import { LEARNING_PATHS, resolveLearningPaths } from '../../lib/learning-paths.mjs';
import type { CatalogEvent, CatalogResource } from '../../types/catalog';
import '../../styles/learning-paths.css';

interface ResolvedStep {
  type: string;
  title: string;
  href: string;
  label: string;
  note: string;
}

interface ResolvedPath {
  id: string;
  title: string;
  seoTitle: string;
  seoDescription: string;
  audience: string;
  intro: string;
  steps: ResolvedStep[];
}

export async function getStaticPaths() {
  const [catalog, posts] = await Promise.all([loadSiteCatalog(), getCollection('blog')]);
  const resources = (catalog as Array<CatalogResource | CatalogEvent>)
    .filter((record): record is CatalogResource => record.recordType !== 'event');
  const paths = resolveLearningPaths(LEARNING_PATHS, resources, posts) as ResolvedPath[];

  return paths.map((path) => ({
    params: { slug: path.id },
    props: { path },
  }));
}

const { path } = Astro.props as { path: ResolvedPath };
---

<BaseLayout
  title={path.seoTitle}
  description={path.seoDescription}
  canonical={`https://dondeaprendoaws.com/recorridos/${path.id}/`}
>
  <SiteHeader />
  <main class="learning-path-detail site-container">
    <nav class="learning-path-detail__breadcrumbs" aria-label="Ruta de navegación">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/recorridos/">Rutas para aprender AWS</a></li>
        <li aria-current="page">{path.title}</li>
      </ol>
    </nav>

    <header class="learning-path-detail__intro">
      <p class="learning-paths__eyebrow">{path.audience}</p>
      <h1>{path.title}</h1>
      <p class="learning-path-detail__summary">{path.intro}</p>
      <p class="learning-path-detail__guidance">Los pasos son sugeridos: seguí el orden o elegí el material que mejor responda a lo que necesitás aprender.</p>
    </header>

    <section class="learning-path-detail__steps" aria-labelledby="learning-path-steps-title">
      <div class="learning-path-detail__section-heading">
        <div>
          <p class="learning-paths__eyebrow">Artículos y recursos</p>
          <h2 id="learning-path-steps-title">Seguí la ruta</h2>
        </div>
        <span>{path.steps.length} pasos</span>
      </div>
      <ol>
        {path.steps.map((step, index) => <li>
          <a class="learning-path-detail__step" href={step.href}>
            <span class="learning-path-detail__step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="learning-path-detail__step-copy">
              <span class="learning-path-detail__step-type">{step.label}</span>
              <strong>{step.title}</strong>
              <span class="learning-path-detail__step-note">{step.note}</span>
            </span>
            <span class="learning-path-detail__step-arrow" aria-hidden="true">↗</span>
          </a>
        </li>)}
      </ol>
    </section>

    <nav class="learning-path-detail__related" aria-label="Más opciones para aprender">
      <a href="/aprender/">Explorá todos los recursos para aprender AWS</a>
      <a href="/recorridos/">Elegí otra ruta</a>
    </nav>
  </main>
  <SiteFooter />
</BaseLayout>
