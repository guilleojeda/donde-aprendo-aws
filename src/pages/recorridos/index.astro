---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getCollection } from 'astro:content';
import { loadSiteCatalog } from '../../lib/site-catalog.mjs';
import { LEARNING_PATHS, resolveLearningPaths, learningPathHref } from '../../lib/learning-paths.mjs';
import type { CatalogEvent, CatalogResource } from '../../types/catalog';
import '../../styles/learning-paths.css';

const [catalog, posts] = await Promise.all([loadSiteCatalog(), getCollection('blog')]);
const resources = (catalog as Array<CatalogResource | CatalogEvent>)
  .filter((record): record is CatalogResource => record.recordType !== 'event');
interface ResolvedStep { type: string; title: string; href: string; label: string; note: string; }
interface ResolvedPath { id: string; title: string; audience: string; intro: string; steps: ResolvedStep[]; }
const paths = resolveLearningPaths(LEARNING_PATHS, resources, posts) as ResolvedPath[];
---

<BaseLayout
  title="Rutas para aprender AWS en español | ¿Dónde Aprendo AWS?"
  description="Elige una ruta para aprender AWS desde cero o avanzar con serverless, seguridad e IA generativa. Cada recorrido ordena artículos y recursos del sitio."
  canonical="https://dondeaprendoaws.com/recorridos/"
>
  <SiteHeader />
  <main id="contenido" tabindex="-1" class="learning-paths site-container">
    <header class="learning-paths__intro">
      <p class="learning-paths__eyebrow">Aprendizaje guiado</p>
      <h1>Elige una ruta para aprender AWS</h1>
      <p>Encuentra un punto de partida o elige un tema. Cada ruta ordena artículos y recursos publicados en el sitio para que puedas seguirlos a tu ritmo.</p>
    </header>

    <nav class="learning-paths__index" aria-label="Rutas para aprender AWS">
      {paths.map((path) => <a id={path.id} href={learningPathHref(path.id)}>
        <span class="learning-paths__audience">{path.audience}</span>
        <strong>{path.title}</strong>
        <small>{path.intro}</small>
        <span class="learning-paths__index-meta">{path.steps.length} pasos sugeridos <span aria-hidden="true">→</span></span>
      </a>)}
    </nav>
  </main>
  <SiteFooter />
</BaseLayout>
