---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Directory from '../../components/Directory.astro';
import CollectionNavigation from '../../components/CollectionNavigation.astro';
import CollectionGuide from '../../components/CollectionGuide.astro';
import { RESOURCE_COLLECTIONS } from '../../lib/resource-collections.mjs';
import { loadSiteCatalog } from '../../lib/site-catalog.mjs';
import type { CatalogEvent, CatalogResource } from '../../types/catalog';

const catalog = await loadSiteCatalog() as Array<CatalogResource | CatalogEvent>;
const allResources = catalog.filter((record): record is CatalogResource => record.recordType !== 'event');
const resources = allResources.filter((record) => record.kind === 'source');
const events = catalog.filter((record): record is CatalogEvent => record.recordType === 'event');
const collectionLinks = RESOURCE_COLLECTIONS.filter((collection) => collection.kind === 'source')
  .map(({ path, label }) => ({ path, label }));
const guide = {
  heading: 'Elige a quién seguir y cómo hacerlo',
  body: 'Canales y autores comparten AWS con formatos y enfoques distintos. Explora las publicaciones y elige las fuentes que coincidan con los temas que sigues y el tiempo que quieres dedicar.',
  points: [
    'Los canales reúnen videos; los blogs publican guías y artículos; los pódcast ofrecen episodios de audio.',
    'Los boletines llevan una selección de novedades y lecturas a tu correo.',
    'Para encontrar una explicación concreta, consulta también los cursos, videos y artículos del catálogo.',
  ],
};
---
<BaseLayout title="Creadores, canales y blogs para aprender AWS en español | ¿Dónde Aprendo AWS?" description="Encuentra creadores, canales, blogs, pódcast y boletines para seguir AWS en español." canonical="https://dondeaprendoaws.com/creadores/">
  <SiteHeader />
  <Directory title="Creadores y canales de AWS en español" intro="Encuentra personas y publicaciones que comparten conocimientos de AWS en español. Explora canales, blogs, pódcast y boletines para seguir los temas y formatos que te interesan." kind="source" resources={resources} allResources={allResources} events={events}>
    <div slot="before-filters" class="collection-page__editorial">
      <CollectionNavigation links={collectionLinks} />
    </div>
    <div slot="after-results" class="collection-page__after-results">
      <CollectionGuide guide={guide} links={[]} />
      <p class="collection-page__catalog-note">
        Para estudiar con materiales concretos, <a href="/aprender/">explora la biblioteca de cursos, videos y artículos</a>.
      </p>
    </div>
  </Directory>
  <SiteFooter />
</BaseLayout>
