---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import EventAgenda from '../../components/EventAgenda.astro';
import CountryNavigation from '../../components/CountryNavigation.astro';
import CountryCommunitySummary from '../../components/CountryCommunitySummary.astro';
import { loadSiteCatalog } from '../../lib/site-catalog.mjs';
import { communityCountryPages, eventCountryPath } from '../../lib/community-country-pages.mjs';
import { COUNTRY_LABELS } from '../../lib/resource-discovery.mjs';
import type { CatalogEvent, CatalogResource } from '../../types/catalog';

export async function getStaticPaths() {
  const catalog = await loadSiteCatalog() as Array<CatalogResource | CatalogEvent>;
  const communities = catalog.filter((record): record is CatalogResource => record.recordType !== 'event' && record.kind === 'community');
  return communityCountryPages(communities).map(({ country, slug }) => ({
    params: { country: slug },
    props: { country },
  }));
}

const { country } = Astro.props;
const catalog = await loadSiteCatalog() as Array<CatalogResource | CatalogEvent>;
const resources = catalog.filter((record): record is CatalogResource => record.recordType !== 'event');
const communities = resources.filter((resource) => resource.kind === 'community' && resource.country === country);
const events = catalog.filter((record): record is CatalogEvent => record.recordType === 'event');
const countryPages = communityCountryPages(resources);
const countryName = COUNTRY_LABELS[country as keyof typeof COUNTRY_LABELS];
const path = eventCountryPath(country);
if (!path || communities.length === 0) throw new Error(`No published community page is available for ${country}`);
const title = `Eventos AWS en ${countryName} | ¿Dónde Aprendo AWS?`;
const description = `Eventos AWS de comunidades de ${countryName}: encuentros presenciales, online e híbridos. Consultá próximos eventos, fechas, horarios e inscripción.`;
const canonical = new URL(path, 'https://dondeaprendoaws.com').href;
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <SiteHeader />
  <main class="event-country-page site-container">
    <nav class="community-breadcrumb" aria-label="Ruta de navegación">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/eventos/">Eventos</a></li>
        <li aria-current="page">{countryName}</li>
      </ol>
    </nav>
    <div class="directory-hero">
      <h1>Eventos AWS en {countryName}</h1>
      <p>Encontrá próximos encuentros presenciales, online e híbridos organizados por comunidades AWS de {countryName}. Consultá fechas, horarios, lugar e inscripción de los eventos publicados en el directorio.</p>
      <p>El país identifica a la comunidad organizadora; no necesariamente el lugar de cada encuentro.</p>
    </div>
    <CountryNavigation pages={countryPages} section="eventos" currentCountry={country} />
    <EventAgenda events={events} resources={resources} country={country} />
    <CountryCommunitySummary country={country} communities={communities} />
  </main>
  <SiteFooter />
</BaseLayout>
