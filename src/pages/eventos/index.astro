---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import EventAgenda from '../../components/EventAgenda.astro';
import CountryNavigation from '../../components/CountryNavigation.astro';
import CollectionNavigation from '../../components/CollectionNavigation.astro';
import { loadSiteCatalog } from '../../lib/site-catalog.mjs';
import { communityCountryPages } from '../../lib/community-country-pages.mjs';
import { EVENT_COLLECTIONS } from '../../lib/event-collections.mjs';
import type { CatalogEvent, CatalogResource } from '../../types/catalog';

const catalog = await loadSiteCatalog() as Array<CatalogResource | CatalogEvent>;
const resources = catalog.filter((record): record is CatalogResource => record.recordType !== 'event');
const events = catalog.filter((record): record is CatalogEvent => record.recordType === 'event');
const countryPages = communityCountryPages(resources);
const collectionLinks = [
  ...Object.values(EVENT_COLLECTIONS).map(({ path, label }) => ({ path, label })),
];
---
<BaseLayout title="Eventos AWS en Latinoamérica | ¿Dónde Aprendo AWS?" description="Encontrá eventos online, presenciales e híbridos organizados por comunidades AWS de Latinoamérica. Consultá fechas, horarios y enlaces de inscripción." canonical="https://dondeaprendoaws.com/eventos/">
  <SiteHeader />
  <main class="event-page site-container">
    <div class="directory-hero"><h1>Eventos AWS en Latinoamérica</h1><p>Encontrá próximos encuentros de comunidades AWS. Explorá opciones en línea, presenciales e híbridas, y consultá fechas, horarios e inscripción.</p></div>
    <CountryNavigation pages={countryPages} section="eventos" />
    <CollectionNavigation links={collectionLinks} label="Colecciones de eventos" />
    <EventAgenda events={events} resources={resources} />
  </main>
  <SiteFooter />
</BaseLayout>
