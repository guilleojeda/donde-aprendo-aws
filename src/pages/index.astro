---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ContributionForm from '../components/ContributionForm.astro';
import LearnerGuide from '../components/LearnerGuide.astro';
import Faq from '../components/Faq.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { loadSiteCatalog } from '../lib/site-catalog.mjs';
import { resourceHref, eventHref, RESOURCE_PATHS } from '../lib/catalog-routes.mjs';
import { communityCountryPages } from '../lib/community-country-pages.mjs';
import { recommendedResources } from '../lib/resource-discovery.mjs';
import { KIND_LABELS } from '../lib/resource-taxonomy.mjs';
import { eventDateLabel, uniqueUpcomingEvents } from '../lib/events.mjs';
import type { CatalogEvent, CatalogResource } from '../types/catalog';

const catalog = await loadSiteCatalog() as Array<CatalogResource | CatalogEvent>;
const resources = catalog.filter((record): record is CatalogResource => record.recordType !== 'event');
const events = catalog.filter((record): record is CatalogEvent => record.recordType === 'event');
const countryPages = communityCountryPages(resources);
const recommended = recommendedResources(resources, 4) as CatalogResource[];
const upcomingEvents = uniqueUpcomingEvents(events);
const upcoming = upcomingEvents.slice(0, 3) as CatalogEvent[];
const counts = Object.fromEntries(Object.keys(RESOURCE_PATHS).map((kind) => [kind, resources.filter((resource) => resource.kind === kind).length]));
const legacyResourceRoutes = Object.fromEntries(resources.map((resource) => [resource.id, RESOURCE_PATHS[resource.kind as keyof typeof RESOURCE_PATHS]]));
const routeData = JSON.stringify(legacyResourceRoutes).replaceAll('<', '\\u003c');
---

<BaseLayout title="Aprende AWS en español | ¿Dónde Aprendo AWS?" description="Encuentra recursos, rutas de aprendizaje, comunidades y próximos eventos para aprender AWS en español." canonical="https://dondeaprendoaws.com/">
  <SiteHeader />
  <script type="application/json" id="legacy-resource-routes" set:html={routeData} />
  <script is:inline>
    const routes = JSON.parse(document.getElementById('legacy-resource-routes').textContent);
    const redirectLegacyHash = () => {
      const hash = location.hash;
      if (hash.startsWith('#resource-')) {
        const path = routes[hash.slice('#resource-'.length)];
        if (path) location.replace(`${path}${hash}`);
      } else if (hash === '#eventos' || hash.startsWith('#event-')) {
        location.replace(`/eventos/${hash}`);
      } else if (hash === '#directory') {
        location.replace('/aprender/');
      }
    };
    window.addEventListener('hashchange', redirectLegacyHash);
    redirectLegacyHash();
  </script>

  <main id="contenido" tabindex="-1" class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="site-container">
        <div class="home-hero__grid">
          <div class="home-hero__copy">
            <p class="home-eyebrow">Aprende a tu ritmo, con la comunidad</p>
            <h1 id="home-title">Encuentra tu camino para aprender AWS.</h1>
            <p class="home-hero__lead">Cursos, videos y guías en español. Rutas para empezar y comunidades para seguir aprendiendo.</p>
            <div class="home-hero__actions">
              <a class="button button--dark" href="/aprender/">Explorar recursos</a>
              <a class="button button--outline" href="/recorridos/primeros-pasos/">Empezar desde cero</a>
            </div>
            <p class="home-hero__note">Elige una pregunta, encuentra un punto de partida y sigue por el camino que te sirva.</p>
          </div>
          <div class="home-hero__figure" aria-hidden="true">
            <span class="home-hero__orbit home-hero__orbit--a"></span>
            <span class="home-hero__orbit home-hero__orbit--b"></span>
            <img class="home-hero__mark" src="/assets/site-logo.svg" alt="" width="154" height="180" />
            <div class="home-hero__caption"><strong>Un recorrido, muchas formas de aprender</strong><span>Empieza por aquí</span></div>
          </div>
        </div>
        <div class="home-stats" aria-label="Contenido disponible en el directorio">
          <div class="home-stat"><strong>{new Intl.NumberFormat('es').format(counts.content)}</strong><span>recursos</span></div>
          <div class="home-stat"><strong>{new Intl.NumberFormat('es').format(counts.source)}</strong><span>fuentes</span></div>
          <div class="home-stat"><strong>{new Intl.NumberFormat('es').format(counts.community)}</strong><span>comunidades</span></div>
          <div class="home-stat"><strong>{new Intl.NumberFormat('es').format(upcomingEvents.length)}</strong><span>próximos eventos</span></div>
        </div>
      </div>
    </section>

    <section class="home-section home-section--compact" aria-labelledby="home-families-title">
      <div class="site-container">
        <div class="section-heading">
          <div><p class="home-eyebrow">Explora por tipo</p><h2 id="home-families-title">¿Qué te gustaría encontrar?</h2><p>Ve directo a una colección, una persona o un encuentro.</p></div>
        </div>
        <nav class="home-family-grid" aria-label="Explorar por tipo">
          <a class="home-family-card" href="/aprender/">
            <svg class="home-family-card__icon" viewBox="0 0 32 32" aria-hidden="true"><path d="M6 5.5h13.5A4.5 4.5 0 0 1 24 10v16H10a4 4 0 0 1-4-4V5.5Zm0 16.7A4 4 0 0 1 10 19h14M12 10h8m-8 4h8" /></svg>
            <strong>Aprender</strong><span>Artículos, videos, cursos y herramientas.</span>
          </a>
          <a class="home-family-card" href="/creadores/">
            <svg class="home-family-card__icon" viewBox="0 0 32 32" aria-hidden="true"><rect x="4.5" y="6" width="23" height="20" rx="3" /><path d="m13 11 7 5-7 5z" /></svg>
            <strong>Creadores y canales</strong><span>Blogs, canales, podcasts y newsletters.</span>
          </a>
          <a class="home-family-card" href="/comunidades/">
            <svg class="home-family-card__icon" viewBox="0 0 32 32" aria-hidden="true"><circle cx="12" cy="11" r="4" /><circle cx="23" cy="12" r="3" /><path d="M4.5 26v-2a7.5 7.5 0 0 1 15 0v2zm16 0v-2a6 6 0 0 1 7-5.9" /></svg>
            <strong>Comunidades</strong><span>Grupos para aprender y compartir.</span>
          </a>
          <a class="home-family-card" href="/eventos/">
            <svg class="home-family-card__icon" viewBox="0 0 32 32" aria-hidden="true"><rect x="5" y="7" width="22" height="21" rx="3" /><path d="M10 4.5v5m12-5v5M5 13h22m-17 5h4m-4 5h9" /></svg>
            <strong>Eventos</strong><span>Charlas y encuentros de la comunidad.</span>
          </a>
        </nav>
        <nav class="home-goals" aria-label="Explorar por objetivo">
          <strong>¿Ya tienes un objetivo?</strong>
          <a href="/aprender/certificaciones/">Certificaciones</a>
          <a href="/aprender/serverless/">Serverless</a>
          <a href="/aprender/seguridad/">Seguridad</a>
          <a href="/aprender/ia-generativa/">IA generativa</a>
        </nav>
      </div>
    </section>

    <LearnerGuide />

    {recommended.length > 0 && <section class="home-section" aria-labelledby="home-recommended-title">
      <div class="site-container">
        <div class="section-heading"><div><p class="home-eyebrow">Selección del directorio</p><h2 id="home-recommended-title">Para empezar a explorar</h2><p>Recursos recomendados de distintas familias.</p></div><a href="/aprender/">Explorar recursos para aprender</a></div>
        <ul class="home-recommendations">
          {recommended.map((resource) => <li><a class="home-recommendation" href={resourceHref(resource)}>
            <span class="home-recommendation__meta">{KIND_LABELS[resource.kind as keyof typeof KIND_LABELS]} · {resource.format}</span>
            <strong>{resource.title}</strong>
            <p>{resource.description}</p>
          </a></li>)}
        </ul>
      </div>
    </section>}

    <section class="home-section home-section--events" aria-labelledby="home-events-title">
      <div class="site-container">
        <div class="section-heading"><div><p class="home-eyebrow">Agenda</p><h2 id="home-events-title">Próximos eventos</h2><p>Elige un encuentro para aprender y conectar.</p></div><a href="/eventos/">Ver agenda completa</a></div>
        {upcoming.length > 0 ? <ol class="home-upcoming-events">
          {upcoming.map((event) => <li><a href={eventHref(event, countryPages, resources)}>
            <time datetime={event.startsAt}>{eventDateLabel(event.startsAt, event.timeZone)}</time>
            <strong>{event.title}</strong>
            <span>{event.organizer}</span>
          </a></li>)}
        </ol> : <p class="home-empty-state">No hay próximos eventos publicados. Vuelve pronto para consultar nuevas fechas.</p>}
      </div>
    </section>

    <ContributionForm />
    <Faq />
  </main>
  <SiteFooter />
</BaseLayout>
