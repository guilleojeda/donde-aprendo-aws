---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import CreatorStatistics from '../../../components/CreatorStatistics.astro';
import '../../../styles/account.css';
import '../../../styles/creators.css';
import { CREATOR_PRIVATE_HEADERS } from '../_creator-page';
import { loadCreatorStatisticsPage } from '../_statistics-page';

export const prerender = false;

const result = await loadCreatorStatisticsPage(Astro.request);
Astro.response.status = result.status;
for (const [name, value] of Object.entries(CREATOR_PRIVATE_HEADERS)) Astro.response.headers.set(name, value);
---

<BaseLayout title="Estadísticas de mi página | ¿Dónde Aprendo AWS?" description="Consulta las visitas, los clics y el origen de las sesiones de tu página de creador." noindex nofollow analytics={false}>
  <SiteHeader />
  <CreatorStatistics result={result} />
  <SiteFooter />
</BaseLayout>
