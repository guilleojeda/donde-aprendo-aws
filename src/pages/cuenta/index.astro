---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import '../../styles/account.css';
import { getAccountAuth } from '../../lib/account-runtime.mjs';

export const prerender = false;

type AccountSession =
  | { state: 'anonymous' }
  | { state: 'disabled'; csrfToken?: string }
  | { state: 'unavailable' }
  | { state: 'authenticated'; account: { email: string }; csrfToken: string; expiresAt: number };

function readAccountSession(value: unknown): AccountSession {
  if (typeof value !== 'object' || value === null) return { state: 'unavailable' };

  const session = value as Record<string, unknown>;
  if (session.state === 'anonymous' || session.state === 'unavailable') {
    return { state: session.state };
  }
  if (session.state === 'disabled') {
    return typeof session.csrfToken === 'string' && session.csrfToken.length > 0
      ? { state: 'disabled', csrfToken: session.csrfToken }
      : { state: 'disabled' };
  }

  if (session.state !== 'authenticated' || typeof session.account !== 'object' || session.account === null) {
    return { state: 'unavailable' };
  }

  const account = session.account as Record<string, unknown>;
  if (
    typeof account.email !== 'string' ||
    account.email.length === 0 ||
    typeof session.csrfToken !== 'string' ||
    session.csrfToken.length === 0 ||
    typeof session.expiresAt !== 'number' ||
    !Number.isFinite(session.expiresAt)
  ) {
    return { state: 'unavailable' };
  }

  return {
    state: 'authenticated',
    account: { email: account.email },
    csrfToken: session.csrfToken,
    expiresAt: session.expiresAt,
  };
}

const callbackState = Astro.url.searchParams.get('estado');
const recognizedCallbackState = callbackState === 'acceso-invalido' || callbackState === 'cancelado' || callbackState === 'no-disponible'
  ? callbackState
  : undefined;

Astro.response.headers.set('Cache-Control', 'private, no-store');

let session: AccountSession = { state: 'unavailable' };
if (!recognizedCallbackState) {
  try {
    const auth = await getAccountAuth();
    session = readAccountSession(await auth.getSession(Astro.request));
  } catch {
    session = { state: 'unavailable' };
  }
}

const pageState = recognizedCallbackState ?? session.state;
Astro.response.status = pageState === 'acceso-invalido' || pageState === 'cancelado'
  ? 400
  : pageState === 'no-disponible' || pageState === 'unavailable'
    ? 503
    : pageState === 'disabled'
      ? 403
      : 200;
---

<BaseLayout
  title="Mi cuenta | ¿Dónde Aprendo AWS?"
  description="Accede a tu cuenta de ¿Dónde Aprendo AWS?"
  noindex
  analytics={false}
>
  <SiteHeader />
  <main id="contenido" tabindex="-1" class="account-page site-container">
    <div class="account-page__content">
      <header class="account-page__header">
        <p class="account-page__eyebrow">¿Dónde Aprendo AWS?</p>
        <h1>Tu cuenta</h1>
      </header>

      {recognizedCallbackState === 'acceso-invalido' && (
        <section class="account-message account-message--error" role="alert" aria-labelledby="account-error-title">
          <h2 id="account-error-title">No pudimos confirmar el acceso</h2>
          <p>El enlace pudo vencer o ya se usó. Vuelve a intentarlo para acceder a tu cuenta.</p>
          <a class="button button--dark" href="/cuenta/ingresar/">Volver a ingresar</a>
        </section>
      )}

      {recognizedCallbackState === 'cancelado' && (
        <section class="account-message" role="status" aria-labelledby="account-cancelled-title">
          <h2 id="account-cancelled-title">Cancelaste el acceso</h2>
          <p>Puedes volver a intentarlo cuando quieras.</p>
          <a class="button button--dark" href="/cuenta/ingresar/">Volver a ingresar</a>
        </section>
      )}

      {(recognizedCallbackState === 'no-disponible' || pageState === 'unavailable') && (
        <section class="account-message account-message--error" role="alert" aria-labelledby="account-unavailable-title">
          <h2 id="account-unavailable-title">No pudimos cargar tu cuenta</h2>
          <p>Inténtalo de nuevo en unos minutos.</p>
          <a class="button button--dark" href="/cuenta/">Reintentar</a>
        </section>
      )}

      {!recognizedCallbackState && session.state === 'anonymous' && (
        <section class="account-card" aria-labelledby="account-access-title">
          <h2 id="account-access-title">Accede o crea una cuenta</h2>
          <p>Ingresa para consultar tu cuenta o crea una con tu correo electrónico.</p>
          <div class="account-actions">
            <a class="button button--dark" href="/cuenta/ingresar/">Ingresar</a>
            <a class="button button--outline" href="/cuenta/registro/">Crear cuenta</a>
          </div>
          <p class="account-card__recovery"><a href="/cuenta/recuperar/">¿Olvidaste tu contraseña?</a></p>
        </section>
      )}

      {!recognizedCallbackState && session.state === 'authenticated' && (
        <section class="account-card" aria-labelledby="account-details-title">
          <h2 id="account-details-title">Tu información</h2>
          <dl class="account-details">
            <div>
              <dt>Correo electrónico</dt>
              <dd>{session.account.email}</dd>
            </div>
            <div>
              <dt>Estado de la cuenta</dt>
              <dd>Activa</dd>
            </div>
          </dl>
          <div class="account-actions">
            <a class="button button--outline" href="/cuenta/creador/">Crear o editar mi página de creador</a>
            <a class="button button--dark" href="/cuenta/estadisticas/">Ver estadísticas</a>
          </div>
          <form method="post" action="/cuenta/salir/" class="account-logout">
            <input type="hidden" name="csrfToken" value={session.csrfToken} />
            <button class="button button--dark" type="submit">Cerrar sesión</button>
          </form>
        </section>
      )}

      {!recognizedCallbackState && session.state === 'disabled' && (
        <section class="account-message account-message--error" role="alert" aria-labelledby="account-disabled-title">
          <h2 id="account-disabled-title">Esta cuenta está desactivada</h2>
          <p>Si necesitas ayuda, <a href="mailto:contact@dondeaprendoaws.com">contacta al equipo</a>.</p>
          {session.csrfToken && (
            <>
              <p>Puedes cerrar la sesión en este navegador.</p>
              <form method="post" action="/cuenta/salir/" class="account-logout">
                <input type="hidden" name="csrfToken" value={session.csrfToken} />
                <button class="button button--dark" type="submit">Cerrar sesión</button>
              </form>
            </>
          )}
        </section>
      )}
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
