---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import AccountLogout from '../../../components/AccountLogout.astro';
import '../../../styles/account.css';
import { getAccountAuth } from '../../../lib/account-runtime.mjs';
import { readLogoutRetryCsrf } from '../../../lib/account-auth.mjs';

export const prerender = false;

let submittedCsrfToken: string | undefined;
let retryLogout = false;
let pageStatus = 405;
let pageMessage = 'Vuelve a tu cuenta para intentarlo de nuevo.';

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Content-Type-Options', 'nosniff');

if (Astro.request.method === 'POST') {
  let result: Response;
  try {
    const auth = await getAccountAuth();
    result = await auth.handle(Astro.request);
  } catch {
    result = new Response(null, {
      status: 503,
      headers: {
        'Cache-Control': 'private, no-store',
        'Referrer-Policy': 'no-referrer',
        'X-Content-Type-Options': 'nosniff',
      },
    });
  }

  const location = result.headers.get('location');
  const wantsJson = Astro.request.headers.get('accept')?.split(',')
    .some((type) => type.trim().split(';')[0] === 'application/json');
  if (wantsJson) {
    const headers = new Headers(result.headers);
    headers.delete('location');
    headers.set('X-Robots-Tag', 'noindex, nofollow');
    const retryCsrf = readLogoutRetryCsrf(result);
    let destination: URL | undefined;
    try {
      if (result.status === 303 && location) destination = new URL(location, Astro.url);
    } catch { /* An invalid destination must never claim a completed logout. */ }

    if (destination && !destination.username && !destination.password
      && (destination.protocol === 'https:' || destination.origin === Astro.url.origin)
      && !(destination.pathname === '/cuenta/' && destination.searchParams.get('estado') === 'no-disponible')) {
      // The auth service constructs this destination only after confirmed
      // revocation (or a consistent read confirming that no session remains).
      return Response.json({ redirect: destination.href }, { status: 200, headers });
    }
    const status = result.status >= 400 ? result.status : 503;
    return Response.json({
      message: typeof retryCsrf === 'string'
        ? 'No pudimos confirmar el cierre de sesión. Inténtalo de nuevo.'
        : status === 403
          ? 'No pudimos validar el cierre de sesión. Vuelve a tu cuenta para intentarlo de nuevo.'
          : 'No pudimos completar el cierre de sesión. Inténtalo de nuevo.',
    }, { status, headers });
  }
  if (result.status === 303 && location) {
    try {
      const target = new URL(location, Astro.url);
      const retryCsrf = readLogoutRetryCsrf(result);
      if (target.pathname === '/cuenta/' && target.searchParams.get('estado') === 'no-disponible'
        && typeof retryCsrf === 'string' && retryCsrf.length > 0) {
        retryLogout = true;
        submittedCsrfToken = retryCsrf;
      }
    } catch {
      retryLogout = false;
    }
  }

  if (retryLogout) {
    pageStatus = 503;
    pageMessage = 'Inténtalo de nuevo para confirmar el cierre de sesión.';
  } else {
    pageStatus = result.status;
    result.headers.forEach((value, name) => {
      if (name !== 'content-type') Astro.response.headers.set(name, value);
    });
    pageMessage = result.status === 403
      ? 'No pudimos validar el cierre de sesión. Vuelve a tu cuenta para intentarlo de nuevo.'
      : 'No pudimos completar el cierre de sesión. Vuelve a tu cuenta para intentarlo de nuevo.';
  }
} else {
  Astro.response.headers.set('Allow', 'POST');
}

Astro.response.status = pageStatus;
---

<BaseLayout
  title="Cerrar sesión | ¿Dónde Aprendo AWS?"
  description="Cierre de sesión de ¿Dónde Aprendo AWS?"
  noindex
  analytics={false}
>
  <SiteHeader />
  <main id="contenido" tabindex="-1" class="account-page site-container">
    <div class="account-page__content">
      <header class="account-page__header">
        <p class="account-page__eyebrow">¿Dónde Aprendo AWS?</p>
        <h1>Cerrar sesión</h1>
      </header>

      <section class="account-message account-message--error" role="alert" aria-labelledby="logout-error-title">
        <h2 id="logout-error-title">{retryLogout ? 'No pudimos confirmar el cierre de sesión' : 'No pudimos completar el cierre de sesión'}</h2>
        <p>{pageMessage}</p>
        {retryLogout && submittedCsrfToken ? (
          <AccountLogout csrfToken={submittedCsrfToken} label="Reintentar cierre de sesión" buttonClass="button button--dark" />
        ) : (
          <a class="button button--dark" href="/cuenta/">Volver a mi cuenta</a>
        )}
      </section>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
