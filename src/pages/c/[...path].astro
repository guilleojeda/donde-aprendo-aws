---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CreatorPublicProfile from '../../components/CreatorPublicProfile.astro';
import CreatorPublicSeries from '../../components/CreatorPublicSeries.astro';
import '../../styles/creators.css';
import { getCreatorRuntime } from '../../lib/creator-runtime.mjs';
import type {
  CreatorProfileDTO,
  CreatorPublicLinkDTO,
  CreatorPublicSeriesSummaryDTO,
  CreatorSeriesDTO,
} from '../../types/creators';

export const prerender = false;

const siteOrigin = 'https://dondeaprendoaws.com';
const rawPath = Astro.url.pathname.startsWith('/c/') ? Astro.url.pathname.slice('/c/'.length) : '';
const slash = rawPath.indexOf('/');
const rawSlug = slash < 0 ? rawPath : rawPath.slice(0, slash);
let slug = '';
let malformedSlug = false;
try {
  slug = decodeURIComponent(rawSlug);
} catch {
  malformedSlug = true;
}
const remainder = slash < 0 ? '' : rawPath.slice(slash);
const suffix = remainder === '/' ? '' : remainder;
const seriesMatch = remainder.match(/^\/series\/([^/]+)\/?$/);
const unsupportedSuffix = remainder !== '' && remainder !== '/' && !seriesMatch;
let seriesSlug = '';
let malformedSeriesSlug = false;
try {
  seriesSlug = seriesMatch ? decodeURIComponent(seriesMatch[1]) : '';
} catch {
  malformedSeriesSlug = true;
}
Astro.response.headers.set('Cache-Control', 'no-store');

let status: 200 | 404 | 503 = 404;
let profile: CreatorProfileDTO | undefined;
let links: CreatorPublicLinkDTO[] = [];
let publicSeries: CreatorPublicSeriesSummaryDTO[] = [];
let pageSeries: CreatorSeriesDTO | undefined;

if (malformedSlug || malformedSeriesSlug || unsupportedSuffix) {
  status = 404;
} else if (slug) {
  try {
    const runtime = await getCreatorRuntime();
    if (seriesMatch && seriesSlug) {
      const result = await runtime.service.readPublicSeries(slug, seriesSlug, { search: Astro.url.search });
      if (result.status === 308 && typeof result.redirectTo === 'string') {
        Astro.response.status = 308;
        Astro.response.headers.set('Location', result.redirectTo);
        return new Response(null, { status: 308, headers: Astro.response.headers });
      }
      if (result.status === 503) {
        status = 503;
      } else if (result.status === 200 && result.profile && result.series && Array.isArray(result.links)) {
        status = 200;
        profile = result.profile as CreatorProfileDTO;
        pageSeries = result.series as CreatorSeriesDTO;
        links = result.links as CreatorPublicLinkDTO[];
      } else if (result.status === 200) {
        status = 503;
      }
    } else {
      const result = await runtime.service.readPublicProfile(slug, {
        suffix,
        search: Astro.url.search,
      });
      if (result.status === 308 && typeof result.redirectTo === 'string') {
        Astro.response.status = 308;
        Astro.response.headers.set('Location', result.redirectTo);
        return new Response(null, { status: 308, headers: Astro.response.headers });
      }
      if (result.status === 503) {
        status = 503;
      } else if (result.status === 200 && !suffix && result.profile) {
        if (!Array.isArray(result.links) || !Array.isArray(result.series)) {
          status = 503;
        } else {
          status = 200;
          profile = result.profile as CreatorProfileDTO;
          links = result.links as CreatorPublicLinkDTO[];
          publicSeries = result.series as CreatorPublicSeriesSummaryDTO[];
        }
      }
    }
  } catch {
    status = 503;
  }
}

Astro.response.status = status;
const canonical = profile
  ? pageSeries
    ? `${siteOrigin}/c/${encodeURIComponent(profile.slug)}/series/${encodeURIComponent(pageSeries.slug)}/`
    : `${siteOrigin}/c/${encodeURIComponent(profile.slug)}/`
  : undefined;
const title = profile && pageSeries
  ? `${pageSeries.name} | ${profile.displayName} | Serie de AWS`
  : profile
    ? `${profile.displayName} | Creador de AWS`
    : status === 503 ? 'Página temporalmente no disponible' : 'Creador no encontrado';
const description = profile && pageSeries
  ? pageSeries.description?.trim() || `Descubre los capítulos de ${pageSeries.name}, compartidos por ${profile.displayName}.`
  : profile
    ? profile.bio?.trim() || `Conoce los recursos de AWS que comparte ${profile.displayName}.`
  : status === 503
    ? 'No pudimos cargar esta página. Inténtalo de nuevo en unos minutos.'
    : 'No encontramos esta página de creador.';
const image = profile?.photo?.url?.startsWith('/media/fotos/')
  ? profile.photo.url
  : profile?.photo?.version !== undefined
    ? `/media/fotos/${encodeURIComponent(profile.id)}/${encodeURIComponent(String(profile.photo.version))}.webp`
    : undefined;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image={image}
  imageAlt={image && profile ? `Foto de ${profile.displayName}` : undefined}
  noindex={status !== 200}
>
  <SiteHeader />
  <main id="contenido" class="creator-page site-container" tabindex="-1">
    {status === 200 && profile && pageSeries ? (
      <CreatorPublicSeries profile={profile} series={pageSeries} links={links} />
    ) : status === 200 && profile ? (
      <CreatorPublicProfile profile={profile} links={links} series={publicSeries} />
    ) : (
      <section class="creator-message" role={status === 503 ? 'alert' : 'status'} aria-labelledby="creator-message-title">
        <p class="creator-profile__eyebrow">¿Dónde Aprendo AWS?</p>
        <h1 id="creator-message-title">{status === 503 ? 'No pudimos cargar esta página' : 'No encontramos a este creador'}</h1>
        <p>{status === 503 ? 'Inténtalo de nuevo en unos minutos.' : 'Revisa la dirección o vuelve a conocer a la comunidad.'}</p>
        <a class="button button--dark" href={status === 503 ? Astro.url.pathname : '/creadores/'}>{status === 503 ? 'Reintentar' : 'Explorar creadores'}</a>
      </section>
    )}
  </main>
  <SiteFooter />
</BaseLayout>
