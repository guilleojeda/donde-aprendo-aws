---
import ResourceCard from './ResourceCard.astro';
import CatalogCriteria from './CatalogCriteria.astro';
import type { CatalogEvent, CatalogResource } from '../types/catalog';
import { TOPICS } from '../lib/resource-taxonomy.mjs';
import { COUNTRY_LABELS, LEVEL_LABELS } from '../lib/resource-discovery.mjs';
import { uniqueUpcomingEventGroups } from '../lib/events.mjs';
import { communityCountryPages } from '../lib/community-country-pages.mjs';

interface Props {
  title: string;
  intro: string;
  kind: 'content' | 'source' | 'community';
  resources: CatalogResource[];
  allResources: CatalogResource[];
  events: CatalogEvent[];
  country?: string;
}

const { title, intro, kind, resources, allResources, events, country } = Astro.props;
const countryLabel = (country: string) => COUNTRY_LABELS[country as keyof typeof COUNTRY_LABELS] ?? country;
const levelLabel = (level: string) => LEVEL_LABELS[level as keyof typeof LEVEL_LABELS] ?? level;
const countryPages = kind === 'community'
  ? communityCountryPages(allResources)
  : [];
const upcomingEventGroups = kind === 'community' ? uniqueUpcomingEventGroups(events) : [];
const countryHasUpcomingEvents = country
  ? upcomingEventGroups.some(({ event }) => event.country === country)
  : false;
const formats = [...new Set(resources.map((resource) => resource.format))]
  .sort((left, right) => left.localeCompare(right, 'es', { sensitivity: 'base' }));
const resourceCountNoun = resources.length === 1 ? 'recurso' : 'recursos';
const topics = TOPICS.filter((topic) => resources.some((resource) => resource.topics.includes(topic)));
const countries = country ? [] : Object.keys(COUNTRY_LABELS).filter((country) => resources.some((resource) => resource.country === country))
  .sort((left, right) => countryLabel(left).localeCompare(countryLabel(right), 'es'));
const levels = kind === 'content'
  ? Object.keys(LEVEL_LABELS).filter((level) => resources.some((resource) => resource.level === level))
  : [];
const resourcesById = new Map(allResources.map((resource) => [resource.id, resource]));
const eventsById = new Map(events.map((event) => [event.id, event]));
const communitiesWithUpcomingEvents = new Set<string>();
for (const group of upcomingEventGroups) {
  for (const event of group.events) {
    if (event.communityId) communitiesWithUpcomingEvents.add(event.communityId);
  }
}
---

<main>
  <section class="directory-section" aria-labelledby="directory-title">
    <div class="site-container directory-section__container">
      {country && <nav class="community-breadcrumb" aria-label="Ruta de navegación">
        <ol>
          <li><a href="/">Inicio</a></li>
          <li><a href="/comunidades/">Comunidades</a></li>
          <li aria-current="page">{countryLabel(country)}</li>
        </ol>
      </nav>}
      <div class="directory-hero">
        <h1 id="directory-title">{title}</h1>
        <p>{intro}</p>
        {country && countryHasUpcomingEvents && <p class="community-country-events">
          <a href={`/eventos/?country=${encodeURIComponent(country)}`}>Ver próximos eventos organizados por comunidades de {countryLabel(country)}</a>
        </p>}
      </div>

      {kind === 'community' && countryPages.length > 0 && <nav class="community-country-nav" aria-label="Comunidades por país">
        <details>
          <summary>{country ? `Cambiar de país · ${countryLabel(country)}` : `Explorá por país · ${countryPages.length} países`}</summary>
          <ul>
            {countryPages.map((page) => <li><a href={page.path} aria-current={page.country === country ? 'page' : undefined}>{page.label} <span>({page.count})</span></a></li>)}
          </ul>
        </details>
      </nav>}

      <div class="directory-controls" data-directory-controls>
        <label class="sr-only" for="resource-search">Buscar en {title.toLowerCase()}</label>
        <input
          id="resource-search"
          class="directory-search"
          type="search"
          placeholder={`Buscar entre ${resources.length} ${resourceCountNoun}`}
          autocomplete="off"
          spellcheck="false"
          data-resource-search
        />
        <div class="directory-facets">
          <div class="directory-facet">
            <label for="resource-format">Formato</label>
            <select id="resource-format" data-format-filter>
              <option value="">Todos los formatos</option>
              {formats.map((format) => <option value={format}>{format}</option>)}
            </select>
          </div>
          {topics.length > 0 && <div class="directory-facet">
            <label for="resource-topic">Tema</label>
            <select id="resource-topic" data-topic-filter>
              <option value="">Todos los temas</option>
              {topics.map((topic) => <option value={topic}>{topic}</option>)}
            </select>
          </div>}
          {countries.length > 0 && <div class="directory-facet">
            <label for="resource-country">País de origen</label>
            <select id="resource-country" data-country-filter>
              <option value="">Todos los países</option>
              {countries.map((country) => <option value={country}>{countryLabel(country)}</option>)}
            </select>
          </div>}
          {levels.length > 0 && <div class="directory-facet" data-level-field>
            <label for="resource-level">Nivel</label>
            <select id="resource-level" data-level-filter>
              <option value="">Todos los niveles</option>
              {levels.map((level) => <option value={level}>{levelLabel(level)}</option>)}
            </select>
          </div>}
        </div>
      </div>

      {resources.length > 0 ? <>
        <h2 class="sr-only">Resultados</h2>
        <div class="directory-list-heading">
          <p class="directory-result-count" data-result-count aria-live="polite">{resources.length} recursos</p>
          <div class="directory-facet directory-facet--sort">
            <label for="resource-sort">Ordenar por</label>
            <select id="resource-sort" data-sort-filter>
              <option value="directory">Orden del directorio</option>
              <option value="recent">Más recientes</option>
              <option value="recommended">Recomendados</option>
            </select>
          </div>
        </div>
        <ul class="resource-list" data-resource-list>
          {resources.map((resource, index) => <ResourceCard
            resource={resource}
            index={index}
            source={resourcesById.get(resource.sourceId ?? '')}
            community={resourcesById.get(resource.communityId ?? '')}
            event={eventsById.get(resource.eventId ?? '')}
            hasUpcomingCommunityEvents={communitiesWithUpcomingEvents.has(resource.id)}
          />)}
        </ul>
        <p class="directory-no-results" data-no-results role="status" hidden>No encontramos recursos con estos filtros.</p>
        <div class="directory-show-more" data-show-more-wrap hidden>
          <button class="button button--dark" type="button" data-show-more>Mostrar 12 más</button>
        </div>
      </> : <p class="directory-empty" role="status">No hay recursos publicados todavía.</p>}

      <CatalogCriteria />
    </div>
  </section>
</main>

{resources.length > 0 && <script src="../scripts/directory.js"></script>}
