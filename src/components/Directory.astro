---
import ResourceCard from './ResourceCard.astro';
import DirectorySort from './DirectorySort.astro';
import CatalogCriteria from './CatalogCriteria.astro';
import CountryNavigation from './CountryNavigation.astro';
import type { CatalogEvent, CatalogResource } from '../types/catalog';
import { TOPICS } from '../lib/resource-taxonomy.mjs';
import { COUNTRY_LABELS, LEVEL_LABELS } from '../lib/resource-discovery.mjs';
import { uniqueUpcomingEventGroups } from '../lib/events.mjs';
import { communityCountryPages, eventCountryPath } from '../lib/community-country-pages.mjs';
import { sortResources } from '../lib/directory-filter.mjs';

interface ResourceGroup {
  id: string;
  label: string;
  description: string;
  resourceIds: string[];
  filterResourceIds?: string[];
}

type OrderedResource = CatalogResource & { directoryIndex: number; purposeGroupIndex: number };

interface Props {
  title: string;
  intro: string;
  kind: 'content' | 'source' | 'community';
  resources: CatalogResource[];
  allResources: CatalogResource[];
  events: CatalogEvent[];
  country?: string;
  breadcrumb?: { label: string; href?: string }[];
  omittedFacets?: ('format' | 'topic' | 'country' | 'level')[];
  showCountryNavigation?: boolean;
  defaultSort?: 'recommended' | 'purpose';
  resourceGroups?: ResourceGroup[];
}

const {
  title, intro, kind, resources, allResources, events, country,
  breadcrumb, omittedFacets = [], showCountryNavigation = true,
  defaultSort = 'recommended', resourceGroups = [],
} = Astro.props;
const countryLabel = (country: string) => COUNTRY_LABELS[country as keyof typeof COUNTRY_LABELS] ?? country;
const levelLabel = (level: string) => LEVEL_LABELS[level as keyof typeof LEVEL_LABELS] ?? level;
const countryPages = communityCountryPages(allResources);
const agendaPath = country ? eventCountryPath(country) : undefined;
const upcomingEventGroups = kind === 'community' ? uniqueUpcomingEventGroups(events) : [];
const omitFacet = (facet: 'format' | 'topic' | 'country' | 'level') => omittedFacets.includes(facet);
const formats = [...new Set(resources.map((resource) => resource.format))]
  .sort((left, right) => left.localeCompare(right, 'es', { sensitivity: 'base' }));
const countNouns = kind === 'community'
  ? { singular: 'comunidad', plural: 'comunidades' }
  : kind === 'source' ? { singular: 'fuente', plural: 'fuentes' } : { singular: 'recurso', plural: 'recursos' };
const resourceCountNoun = resources.length === 1 ? countNouns.singular : countNouns.plural;
const topics = TOPICS.filter((topic) => resources.some((resource) => resource.topics.includes(topic)));
const countries = country ? [] : Object.keys(COUNTRY_LABELS).filter((country) => resources.some((resource) => resource.country === country))
  .sort((left, right) => countryLabel(left).localeCompare(countryLabel(right), 'es'));
const levels = kind === 'content'
  ? Object.keys(LEVEL_LABELS).filter((level) => resources.some((resource) => resource.level === level))
  : [];
const hasPrimaryGroup = resourceGroups.some((group) => (group.filterResourceIds ?? group.resourceIds).length > 0);
const availableFacets = [
  !omitFacet('format') && formats.length > 0,
  !omitFacet('topic') && topics.length > 0,
  !omitFacet('country') && countries.length > 0,
  !omitFacet('level') && levels.length > 0,
].some(Boolean);
const groupByResourceId = new Map(resourceGroups.flatMap((group, groupIndex) => group.resourceIds
  .map((resourceId) => [resourceId, { ...group, groupIndex }] as const)));
const orderedResources = sortResources(resources.map((resource, directoryIndex) => ({
  ...resource,
  directoryIndex,
  purposeGroupIndex: groupByResourceId.get(resource.id)?.groupIndex ?? Number.MAX_SAFE_INTEGER,
})), defaultSort) as OrderedResource[];
const resourcesById = new Map(allResources.map((resource) => [resource.id, resource]));
const eventsById = new Map(events.map((event) => [event.id, event]));
const communitiesWithUpcomingEvents = new Set<string>();
for (const group of upcomingEventGroups) {
  for (const event of group.events) {
    if (event.communityId) communitiesWithUpcomingEvents.add(event.communityId);
  }
}
---

<main id="contenido" tabindex="-1">
  <section class="directory-section" aria-labelledby="directory-title">
    <div class="site-container directory-section__container">
      {breadcrumb?.length ? <nav class="community-breadcrumb" aria-label="Ruta de navegación">
        <ol>
          {breadcrumb.map((item, index) => <li>
            {item.href && index < breadcrumb.length - 1
              ? <a href={item.href}>{item.label}</a>
              : <span aria-current="page">{item.label}</span>}
          </li>)}
        </ol>
      </nav> : country && <nav class="community-breadcrumb" aria-label="Ruta de navegación">
        <ol>
          <li><a href="/">Inicio</a></li>
          <li><a href="/comunidades/">Comunidades</a></li>
          <li aria-current="page">{countryLabel(country)}</li>
        </ol>
      </nav>}
      <header class="directory-hero">
        <h1 id="directory-title">{title}</h1>
        <p>{intro}</p>
        {kind === 'community' && country && agendaPath && <p class="community-country-events">
          <a href={agendaPath}>Consultar agenda de eventos organizados por comunidades de {countryLabel(country)}</a>
        </p>}
      </header>

      {kind === 'community' && showCountryNavigation && <CountryNavigation pages={countryPages} section="comunidades" currentCountry={country} showCounts />}

      <slot name="before-filters" />

      <div class="directory-controls" data-directory-controls>
        <label class="sr-only" for="resource-search">Buscar en {title}</label>
        <input
          id="resource-search"
          class="directory-search"
          type="search"
          placeholder={`Buscar entre ${resources.length} ${resourceCountNoun}`}
          autocomplete="off"
          spellcheck="false"
          data-resource-search
        />
        {hasPrimaryGroup && <div class="directory-controls__primary-row">
          <div class="directory-facet directory-facet--primary-group">
            <label for="resource-group">Examen o tipo de recurso</label>
            <select id="resource-group" data-group-filter>
              <option value="">Todos los exámenes y recursos</option>
              {resourceGroups.filter((group) => (group.filterResourceIds ?? group.resourceIds).length > 0).map((group) =>
                <option value={group.id}>{group.label}</option>
              )}
            </select>
          </div>
          <DirectorySort defaultSort={defaultSort} />
        </div>}
        {availableFacets && <details class="directory-filter-disclosure" data-filter-disclosure>
          <summary>Filtros adicionales</summary>
          <div class="directory-facets">
            {!omitFacet('format') && formats.length > 0 && <div class="directory-facet">
              <label for="resource-format">Formato</label>
              <select id="resource-format" data-format-filter>
                <option value="">Todos los formatos</option>
                {formats.map((format) => <option value={format}>{format}</option>)}
              </select>
            </div>}
            {!omitFacet('topic') && topics.length > 0 && <div class="directory-facet">
              <label for="resource-topic">Tema</label>
              <select id="resource-topic" data-topic-filter>
                <option value="">Todos los temas</option>
                {topics.map((topic) => <option value={topic}>{topic}</option>)}
              </select>
            </div>}
            {!omitFacet('country') && countries.length > 0 && <div class="directory-facet">
              <label for="resource-country">País de origen</label>
              <select id="resource-country" data-country-filter>
                <option value="">Todos los países</option>
                {countries.map((country) => <option value={country}>{countryLabel(country)}</option>)}
              </select>
            </div>}
            {!omitFacet('level') && levels.length > 0 && <div class="directory-facet" data-level-field>
              <label for="resource-level">Nivel</label>
              <select id="resource-level" data-level-filter>
                <option value="">Todos los niveles</option>
                {levels.map((level) => <option value={level}>{levelLabel(level)}</option>)}
              </select>
            </div>}
          </div>
        </details>}
      </div>

      {resources.length > 0 ? <>
        <h2 class="sr-only">Resultados</h2>
        <div class="directory-list-heading">
          <p class="directory-result-count" data-result-count data-count-singular={countNouns.singular} data-count-plural={countNouns.plural} aria-live="polite">{resources.length} {resourceCountNoun}</p>
          {!hasPrimaryGroup && <DirectorySort defaultSort={defaultSort} />}
        </div>
        <ul class="resource-list" data-resource-list data-resource-groups={resourceGroups.length ? JSON.stringify(resourceGroups) : undefined}>
          {(() => {
            let previousGroupId: string | undefined;
            return orderedResources.map((resource) => {
              const group = groupByResourceId.get(resource.id);
              const showHeading = defaultSort === 'purpose' && group && group.id !== previousGroupId;
              previousGroupId = group?.id;
              return <>
                {showHeading && <li class="resource-list__group-heading" data-resource-group-heading>
                  <h2>{group.label}</h2>
                  <p>{group.description}</p>
                </li>}
                <ResourceCard
                  resource={resource}
                  index={resource.directoryIndex}
                  source={resourcesById.get(resource.sourceId ?? '')}
                  community={resourcesById.get(resource.communityId ?? '')}
                  event={eventsById.get(resource.eventId ?? '')}
                  countryPages={countryPages}
                  catalogResources={allResources}
                  hasUpcomingCommunityEvents={communitiesWithUpcomingEvents.has(resource.id)}
                />
              </>;
            });
          })()}
        </ul>
        <p class="directory-no-results" data-no-results role="status" hidden>No encontramos recursos con estos filtros.</p>
        <div class="directory-show-more" data-show-more-wrap hidden>
          <button class="button button--dark" type="button" data-show-more>Mostrar 12 más</button>
        </div>
      </> : <p class="directory-empty" role="status">No hay recursos publicados todavía.</p>}

      <slot name="after-results" />

      <CatalogCriteria />
    </div>
  </section>
</main>

{resources.length > 0 && <script src="../scripts/directory.js"></script>}
