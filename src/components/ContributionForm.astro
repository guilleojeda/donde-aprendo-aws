---
import { FORMATS_BY_KIND, KIND_LABELS, TOPICS } from '../lib/resource-taxonomy.mjs';

const submissionApiUrl = import.meta.env.PUBLIC_SUBMISSION_API_URL?.trim() ?? '';

if (import.meta.env.PROD && !submissionApiUrl) {
  throw new Error('PUBLIC_SUBMISSION_API_URL must be set for a production build');
}

---

<section class="contribution-section" id="cta_form-01-839181" aria-labelledby="contribution-title">
  <div class="site-container site-container--small">
    <div class="section-heading contribution-heading">
      <h2 id="contribution-title">Comparte un recurso</h2>
      <p>Comparte recursos en español para ayudar a otras personas a aprender AWS.</p>
    </div>

    <form
      class="contribution-form"
      data-contribution-form
      data-api-url={submissionApiUrl}
      aria-describedby="contribution-help contribution-status"
    >
      <p id="contribution-help" class="contribution-form__help">
        Completa los datos de tu contenido. Revisaremos el envío antes de publicarlo.
      </p>

      <div class="contribution-form__fields">
        <div class="contribution-form__field">
          <label for="contribution-email">Tu correo electrónico</label>
          <input
            id="contribution-email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="tucorreo@tudominio.com"
            maxlength="254"
            aria-describedby="contribution-help contribution-email-error"
            required
          />
          <span class="contribution-form__error" id="contribution-email-error" data-contribution-error hidden></span>
        </div>

        <div class="contribution-form__field">
          <label for="contribution-full-name">Tu nombre completo</label>
          <input
            id="contribution-full-name"
            name="full_name"
            type="text"
            autocomplete="name"
            placeholder="Escribe tu nombre completo"
            maxlength="160"
            aria-describedby="contribution-help contribution-full-name-error"
            required
          />
          <span class="contribution-form__error" id="contribution-full-name-error" data-contribution-error hidden></span>
        </div>

        <div class="contribution-form__field contribution-form__field--full">
          <label for="contribution-title-field">Título o nombre</label>
          <input
            id="contribution-title-field"
            name="title"
            type="text"
            autocomplete="off"
            placeholder="Por ejemplo: AWS IAM explicado en 5 minutos"
            maxlength="240"
            aria-describedby="contribution-help contribution-title-field-error"
            required
          />
          <span class="contribution-form__error" id="contribution-title-field-error" data-contribution-error hidden></span>
        </div>

        <div class="contribution-form__field contribution-form__field--full">
          <label for="contribution-url">URL</label>
          <input
            id="contribution-url"
            name="url"
            type="url"
            inputmode="url"
            autocomplete="url"
            placeholder="https://tucontenido.tudominio.com"
            maxlength="2048"
            aria-describedby="contribution-help contribution-url-error"
            required
          />
          <span class="contribution-form__error" id="contribution-url-error" data-contribution-error hidden></span>
        </div>

        <div class="contribution-form__field contribution-form__field--full">
          <label for="contribution-text">Descripción</label>
          <textarea
            id="contribution-text"
            name="text"
            rows="5"
            placeholder="Por ejemplo: Te explico en 5 minutos cómo funciona AWS IAM y cómo darle permisos a los usuarios que necesiten acceder a tu cuenta de AWS"
            maxlength="8000"
            aria-describedby="contribution-help contribution-text-error"
            required
          ></textarea>
          <span class="contribution-form__error" id="contribution-text-error" data-contribution-error hidden></span>
        </div>

        <div class="contribution-form__field contribution-form__field--full">
          <label for="contribution-kind">¿Qué compartes?</label>
          <select id="contribution-kind" name="kind" data-contribution-kind aria-describedby="contribution-help contribution-kind-error" required>
            <option value="">Selecciona una opción</option>
            {Object.entries(KIND_LABELS).map(([kind, label]) => <option value={kind}>{label}</option>)}
          </select>
          <span class="contribution-form__error" id="contribution-kind-error" data-contribution-error hidden></span>
        </div>

        <div class="contribution-form__field">
          <label for="contribution-format">Formato</label>
          <select id="contribution-format" name="format" data-contribution-format aria-describedby="contribution-help contribution-format-error" required>
            <option value="">Selecciona un formato</option>
            {Object.entries(FORMATS_BY_KIND).flatMap(([kind, formats]) => formats.map((format) => (
              <option value={format} data-format-kind={kind} hidden disabled>{format}</option>
            )))}
          </select>
          <span class="contribution-form__error" id="contribution-format-error" data-contribution-error hidden></span>
        </div>

        <fieldset class="contribution-form__topics contribution-form__field--full">
          <legend>Temas <span>(opcional, hasta tres)</span></legend>
          <div class="contribution-form__topic-options">
            {TOPICS.map((topic) => (
              <label><input type="checkbox" name="topics" value={topic} data-contribution-topic /> {topic}</label>
            ))}
          </div>
        </fieldset>
      </div>

      <div class="contribution-form__honeypot" aria-hidden="true">
        <label for="contribution-website">Sitio web</label>
        <input id="contribution-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button class="button button--dark contribution-form__submit" type="submit" data-contribution-submit>
        Enviar para revisión
      </button>

      <p
        id="contribution-status"
        class="contribution-form__status"
        data-contribution-status
        role="status"
        tabindex="-1"
        aria-live="polite"
        aria-atomic="true"
        hidden
      ></p>
    </form>
  </div>
</section>

<script src="../scripts/contribution-form.js"></script>
