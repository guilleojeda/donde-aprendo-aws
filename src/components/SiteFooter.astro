---
import ReportLink from './ReportLink.astro';

const resourceLinks = [
  ['AWS for Engineers', 'https://awsforengineers.com/?utm_source=dondeaprendoaws&utm_medium=home'],
  ['Simple AWS', 'https://newsletter.simpleaws.dev?utm_source=dondeaprendoaws&utm_medium=home'],
  ['Cloudy Things blog', 'https://blog.guilleojeda.com/?utm_source=dondeaprendoaws&utm_medium=home'],
  ['Node.js on AWS', 'https://learning.simpleaws.dev/b/nodejsonaws?utm_source=dondeaprendoaws&utm_medium=home'],
];
---

<footer class="site-footer">
  <div class="site-container">
    <div class="site-footer__top">
      <div class="site-footer__column site-footer__info">
        <a class="site-footer__brand" href="/" aria-label="Inicio: ¿Dónde Aprendo AWS?">
          <img src="/assets/site-logo.svg" alt="" width="30" height="36" />
          <span>¿Dónde Aprendo AWS?</span>
        </a>
        <p>Dónde Aprendo AWS reúne recursos en español, creadores, comunidades y eventos para aprender Amazon Web Services.</p>
        <ul class="site-footer__explore">
          <li><a href="/aprender/cursos/">Cursos AWS</a></li>
          <li><a href="/recorridos/">Rutas de aprendizaje</a></li>
          <li><a href="/comunidades/">Comunidades por país</a></li>
          <li><a href="/eventos/">Próximos eventos</a></li>
        </ul>
      </div>
      <div class="site-footer__column">
        <h3>Otros recursos</h3>
        <ul>
          {resourceLinks.map(([label, href]) => <li><a href={href} target="_blank" rel="noopener">{label}</a></li>)}
        </ul>
      </div>
      <div class="site-footer__column">
        <h3>Síguenos en las redes</h3>
        <div class="social-links">
          <a href="https://www.linkedin.com/in/guilleojeda/" target="_blank" rel="noopener" aria-label="LinkedIn">in</a>
          <a href="https://www.twitter.com/itsguilleojeda" target="_blank" rel="noopener" aria-label="X">X</a>
        </div>
      </div>
    </div>
    <div class="site-footer__bottom">
      <p>
        <a href="mailto:contact@dondeaprendoaws.com">Contacto</a>
        · <ReportLink />. Al elegir este enlace, tu cliente de correo abrirá un mensaje que deberás enviar.
      </p>
    </div>
  </div>
</footer>
