---
const contributorUrl = '/#cta_form-01-839181';
const navigationLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/aprender/', label: 'Aprender' },
  { href: '/recorridos/', label: 'Rutas' },
  { href: '/creadores/', label: 'Creadores' },
  { href: '/comunidades/', label: 'Comunidades' },
  { href: '/eventos/', label: 'Eventos' },
  { href: '/blog/', label: 'Blog' },
  { href: '/buscar/', label: 'Buscar' },
  { href: '/cuenta/', label: 'Mi cuenta' },
  { href: contributorUrl, label: 'Comparte un recurso', className: 'site-nav__cta' },
];
---

<header class="site-header">
  <nav class="site-nav site-container" aria-label="Navegación principal">
    <a class="site-nav__brand" href="/" aria-label="Inicio: ¿Dónde Aprendo AWS?">
      <span class="site-brand__mark" aria-hidden="true">
        <img class="site-logo--light" src="/assets/site-logo.svg" alt="" width="34" height="40" />
        <img class="site-logo--dark" src="/assets/site-logo-white.svg" alt="" width="34" height="40" />
      </span>
      <span>¿Dónde Aprendo AWS?</span>
    </a>

    <button
      class="site-nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Abrir menú"
    >
      <span></span><span></span><span></span>
    </button>

    <div class="site-theme-slot">
      <button
        class="site-theme-toggle"
        type="button"
        data-theme-toggle
        hidden
        aria-label="Modo oscuro"
        aria-pressed="false"
      >
        <svg class="site-theme-toggle__icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
          <path d="M20.2 15.3A8.4 8.4 0 0 1 8.7 3.8 8.5 8.5 0 1 0 20.2 15.3Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
        </svg>
      </button>
    </div>

    <noscript>
      <div class="site-nav__noscript-menu">
        {navigationLinks.map((link) => <a class={link.className} href={link.href} data-event-agenda-route={link.href === '/eventos/' ? '' : undefined}>{link.label}</a>)}
      </div>
    </noscript>

    <div class="site-nav__menu" id="site-menu">
      {navigationLinks.map((link) => <a class={link.className} href={link.href} data-event-agenda-route={link.href === '/eventos/' ? '' : undefined}>{link.label}</a>)}
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-nav__toggle');
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const menu = document.querySelector<HTMLDivElement>('#site-menu');
  const brand = document.querySelector<HTMLAnchorElement>('.site-nav__brand');
  const mobileMenuMedia = window.matchMedia('(max-width: 1100px)');

  if (toggle && menu) {
    const closeMenu = (restoreFocus = false) => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Abrir menú');
      menu.classList.remove('is-open');
      document.body.classList.remove('menu-is-open');
      if (restoreFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu();
      } else {
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', 'Cerrar menú');
        menu.classList.add('is-open');
        document.body.classList.add('menu-is-open');
      }
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    mobileMenuMedia.addEventListener('change', (event) => {
      if (event.matches) {
        if (menu.contains(document.activeElement)) {
          closeMenu();
          toggle.focus();
        }
        return;
      }

      const toggleHadFocus = document.activeElement === toggle;
      if (toggle.getAttribute('aria-expanded') === 'true') closeMenu();
      if (toggleHadFocus) (brand ?? menu.querySelector('a[href]'))?.focus();
    });

    document.addEventListener('keydown', (event) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      if (event.key === 'Escape') {
        closeMenu(true);
        return;
      }
      if (event.key !== 'Tab') return;

      const focusable = [toggle, ...(themeToggle ? [themeToggle] : []), ...menu.querySelectorAll<HTMLAnchorElement>('a[href]')];
      const activeIndex = focusable.findIndex((element) => element === document.activeElement);
      if (activeIndex === -1) {
        event.preventDefault();
        toggle.focus();
      } else if (event.shiftKey && activeIndex === 0) {
        event.preventDefault();
        focusable[focusable.length - 1]?.focus();
      } else if (!event.shiftKey && activeIndex === focusable.length - 1) {
        event.preventDefault();
        toggle.focus();
      }
    });
  }
</script>
