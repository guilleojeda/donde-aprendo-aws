---
const partnerUrl = 'https://www.simpleaws.dev?utm_source=dondeaprendoaws&utm_medium=website&utm_campaign=home';
---

<section class="partner-section" aria-labelledby="partner-title">
  <div class="site-container site-container--small">
    <div class="section-heading section-heading--light">
      <h2 id="partner-title">Nuestros socios</h2>
      <p>Estamos orgullosos de trabajar con estas organizaciones.</p>
    </div>
    <a class="partner-logo" href={partnerUrl} target="_blank" rel="noopener" aria-label="Simple AWS">
      <img src="/assets/simple-aws-logo.png" width="130" height="100" alt="Logo simple aws blanco" loading="lazy" />
    </a>
  </div>
</section>
