---
import { COUNTRY_LABELS, LEVEL_LABELS } from '../lib/resource-discovery.mjs';
import { eventHref, resourceHref } from '../lib/catalog-routes.mjs';
import { eventCountryPath } from '../lib/community-country-pages.mjs';
import ReportLink from './ReportLink.astro';

interface Resource {
  id: string;
  title: string;
  url: string;
  description?: string;
  category: string;
  featured?: boolean;
  kind: string;
  format: string;
  topics: string[];
  addedAt?: string;
  country?: string;
  level?: string;
  sourceId?: string;
  communityId?: string;
  eventId?: string;
}

interface Event { id: string; title: string; country?: string; }

interface CountryPage { country: string; label: string; slug: string; path: string; count: number; }

interface Props {
  resource: Resource;
  index: number;
  source?: Resource;
  community?: Resource;
  event?: Event;
  countryPages?: CountryPage[];
  catalogResources?: Resource[];
  hasUpcomingCommunityEvents?: boolean;
}

const { resource, index, source, community, event, countryPages = [], catalogResources = [], hasUpcomingCommunityEvents = false } = Astro.props;
const countryLabel = (country?: string) => country ? COUNTRY_LABELS[country as keyof typeof COUNTRY_LABELS] ?? country : '';
const levelLabel = (level?: string) => level ? LEVEL_LABELS[level as keyof typeof LEVEL_LABELS] ?? level : '';
const agendaPath = resource.kind === 'community' && resource.country ? eventCountryPath(resource.country) : undefined;
const relatedSource = source?.kind === 'source' ? source : undefined;
const relatedCommunity = community?.kind === 'community' ? community : undefined;
const addedAtLabel = (date: string) => new Intl.DateTimeFormat('es', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${date}T00:00:00Z`));
---

<li
  id={`resource-${resource.id}`}
  tabindex="-1"
  class="resource-card"
  data-resource-index={index}
  data-category={resource.category}
  data-topics={resource.topics.length ? resource.topics.join('|') : undefined}
  data-country={resource.country || undefined}
  data-level={resource.level || undefined}
  data-featured={resource.featured ? 'true' : undefined}
>
  <a class="resource-card__main-link" href={resource.url} target="_blank" rel="noopener noreferrer">
    <div class="resource-card__meta">
      <span>{resource.format}</span>
      {resource.topics.slice(0, 2).map((topic) => <span>{topic}</span>)}
      {resource.country && <span>{countryLabel(resource.country)}</span>}
      {resource.level && <span>{levelLabel(resource.level)}</span>}
    </div>
    <h3>{resource.title}</h3>
    {resource.description && <p class="resource-card__description">{resource.description}</p>}
    {resource.addedAt && <p class="resource-card__added"><span>Agregado al directorio</span> <time datetime={resource.addedAt}>{addedAtLabel(resource.addedAt)}</time></p>}
  </a>
  <div class="resource-card__related">
    {resource.featured && <a href="#directory-criteria" class="resource-card__recommendation">Recomendado</a>}
    {relatedSource && <a href={resourceHref(relatedSource)} data-resource-jump={relatedSource.id}>Autor o fuente: {relatedSource.title}</a>}
    {relatedCommunity && <a href={resourceHref(relatedCommunity)} data-resource-jump={relatedCommunity.id}>Comunidad: {relatedCommunity.title}</a>}
    {event && <a href={eventHref(event, countryPages, catalogResources)}>Grabación de: {event.title}</a>}
    {agendaPath && <a href={agendaPath}>Consultar agenda de {countryLabel(resource.country)}</a>}
    {resource.kind === 'community' && hasUpcomingCommunityEvents && <a href={`/eventos/?community=${encodeURIComponent(resource.id)}`}>
      Ver eventos de esta comunidad
    </a>}
    <ReportLink title={resource.title} recordId={resource.id} targetUrl={resource.url} />
  </div>
</li>
