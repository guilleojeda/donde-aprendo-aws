---
interface Resource {
  id: string;
  title: string;
  url: string;
  description?: string;
  category: string;
  featured?: boolean;
  kind: string;
  format: string;
  topics: string[];
}

interface Props {
  resource: Resource;
  index: number;
}

const { resource, index } = Astro.props;
const searchValue = `${resource.title} ${resource.description ?? ''} ${resource.category} ${resource.format} ${resource.topics.join(' ')}`;
---

<li
  class="resource-list__item"
  data-resource-index={index}
  data-category={resource.category}
  data-kind={resource.kind}
  data-format={resource.format}
  data-topics={resource.topics.join('|')}
  data-search={searchValue}
>
  <article class="resource-card">
    <a href={resource.url} target="_blank" rel="noopener">
      <div class="resource-card__meta">
        <span class="resource-card__format">{resource.format}</span>
        {resource.topics.slice(0, 2).map((topic) => <span class="resource-card__topic">{topic}</span>)}
      </div>
      <div class="resource-card__title-box">
        <h3 class="resource-card__title">{resource.title}</h3>
        <span
          class:list={['resource-card__star', { 'is-featured': resource.featured }]}
          aria-label={resource.featured ? 'Contenido destacado' : 'Contenido del directorio'}
          title={resource.featured ? 'Contenido destacado' : undefined}
          aria-hidden={resource.featured ? undefined : 'true'}
        >☆</span>
      </div>
      <p class="resource-card__description">{resource.description ?? ''}</p>
    </a>
  </article>
</li>
