---
import { COUNTRY_LABELS, LEVEL_LABELS } from '../lib/resource-discovery.mjs';
import { eventHref, resourceHref } from '../lib/catalog-routes.mjs';
import ReportLink from './ReportLink.astro';

interface Resource {
  id: string;
  title: string;
  url: string;
  description?: string;
  category: string;
  featured?: boolean;
  kind: string;
  format: string;
  topics: string[];
  addedAt?: string;
  country?: string;
  level?: string;
  sourceId?: string;
  communityId?: string;
  eventId?: string;
}

interface Event { id: string; title: string; }

interface Props {
  resource: Resource;
  index: number;
  source?: Resource;
  community?: Resource;
  event?: Event;
  hasUpcomingCommunityEvents?: boolean;
}

const { resource, index, source, community, event, hasUpcomingCommunityEvents = false } = Astro.props;
const countryLabel = (country?: string) => country ? COUNTRY_LABELS[country as keyof typeof COUNTRY_LABELS] ?? country : '';
const levelLabel = (level?: string) => level ? LEVEL_LABELS[level as keyof typeof LEVEL_LABELS] ?? level : '';
const relatedSource = source?.kind === 'source' ? source : undefined;
const relatedCommunity = community?.kind === 'community' ? community : undefined;
const searchValue = `${resource.title} ${resource.description ?? ''} ${resource.category} ${resource.format} ${resource.topics.join(' ')} ${countryLabel(resource.country)} ${levelLabel(resource.level)} ${relatedSource?.title ?? ''} ${relatedCommunity?.title ?? ''} ${event?.title ?? ''}`;
const addedAtLabel = (date: string) => new Intl.DateTimeFormat('es', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${date}T00:00:00Z`));
---

<li
  id={`resource-${resource.id}`}
  tabindex="-1"
  class="resource-list__item"
  data-resource-index={index}
  data-category={resource.category}
  data-kind={resource.kind}
  data-format={resource.format}
  data-topics={resource.topics.join('|')}
  data-country={resource.country ?? ''}
  data-level={resource.level ?? ''}
  data-featured={String(Boolean(resource.featured))}
  data-added-at={resource.addedAt ?? ''}
  data-search={searchValue}
>
  <article class="resource-card">
    <a class="resource-card__main-link" href={resource.url} target="_blank" rel="noopener noreferrer">
      <div class="resource-card__meta">
        <span class="resource-card__format">{resource.format}</span>
        {resource.topics.slice(0, 2).map((topic) => <span class="resource-card__topic">{topic}</span>)}
        {resource.country && <span class="resource-card__topic">{countryLabel(resource.country)}</span>}
        {resource.level && <span class="resource-card__topic">{levelLabel(resource.level)}</span>}
      </div>
      <div class="resource-card__title-box">
        <h3 class="resource-card__title">{resource.title}</h3>
      </div>
      <p class="resource-card__description">{resource.description ?? ''}</p>
      {resource.addedAt && <p class="resource-card__added"><span>Agregado al directorio</span> <time datetime={resource.addedAt}>{addedAtLabel(resource.addedAt)}</time></p>}
    </a>
    <div class="resource-card__related">
        {resource.featured && <a href="#directory-criteria" class="resource-card__recommendation">Recomendado</a>}
        {relatedSource && <a href={resourceHref(relatedSource)} data-resource-jump={relatedSource.id}>Autor o fuente: {relatedSource.title}</a>}
        {relatedCommunity && <a href={resourceHref(relatedCommunity)} data-resource-jump={relatedCommunity.id}>Comunidad: {relatedCommunity.title}</a>}
        {event && <a href={eventHref(event)}>Grabación de: {event.title}</a>}
        {resource.kind === 'community' && hasUpcomingCommunityEvents && <a href={`/eventos/?community=${encodeURIComponent(resource.id)}`}>
          Ver agenda de eventos
        </a>}
        <ReportLink title={resource.title} recordId={resource.id} targetUrl={resource.url} />
    </div>
  </article>
</li>
