---
import type { CreatorEditorDTO, CreatorProgram, CreatorSocial } from '../types/creators';
import { safeJsonForScript } from '../pages/cuenta/_creator-page';
import type { CreatorStatisticsPageLoad } from '../pages/cuenta/_statistics-page';
import AccountLogout from './AccountLogout.astro';
import CreatorOwnerActivity from './CreatorOwnerActivity.astro';
import CreatorOwnerLinks from './CreatorOwnerLinks.astro';
import CreatorOwnerClaims from './CreatorOwnerClaims.astro';
import CreatorOwnerSeries from './CreatorOwnerSeries.astro';
import CreatorStatistics from './CreatorStatistics.astro';
import { DEFAULT_CREATOR_OWNER_LINKS_QUERY, type CreatorOwnerLinksQuery } from '../lib/creator-owner-links';
import { DEFAULT_CREATOR_OWNER_SERIES_QUERY, type CreatorOwnerSeriesQuery } from '../lib/creator-owner-series';

type OwnerView = 'enlaces' | 'series' | 'estadisticas' | 'solicitudes';

interface Props {
  data: CreatorEditorDTO;
  accountEmail: string;
  logoutCsrfToken: string;
  csrfToken: string;
  sessionBinding: string;
  isAdmin: boolean;
  publicOrigin: string;
  view: OwnerView;
  linksQuery?: CreatorOwnerLinksQuery;
  linksQueryError?: string;
  seriesQuery?: CreatorOwnerSeriesQuery;
  seriesQueryError?: string;
  statistics?: CreatorStatisticsPageLoad;
}

const { data, accountEmail, logoutCsrfToken, csrfToken, sessionBinding, isAdmin, publicOrigin, view, linksQuery = DEFAULT_CREATOR_OWNER_LINKS_QUERY, linksQueryError, seriesQuery = DEFAULT_CREATOR_OWNER_SERIES_QUERY, seriesQueryError, statistics } = Astro.props;
const profile = data.profile;
const initialStatisticsPeriod = statistics?.period ?? 30;
const photoPath = profile?.photo?.version !== undefined
  ? `/media/fotos/${encodeURIComponent(profile.id)}/${encodeURIComponent(String(profile.photo.version))}.webp`
  : undefined;
const canonicalPath = profile ? `/c/${encodeURIComponent(profile.slug)}/` : undefined;
const canonicalUrl = canonicalPath ? new URL(canonicalPath, publicOrigin).href : undefined;
const socials: Array<{ key: CreatorSocial; label: string }> = [
  { key: 'instagram', label: 'Instagram' },
  { key: 'x', label: 'X' },
  { key: 'linkedin', label: 'LinkedIn' },
  { key: 'awsBuilder', label: 'AWS Builder Center' },
  { key: 'website', label: 'Sitio web o newsletter' },
];
const programs: CreatorProgram[] = ['User Group Leaders', 'Community Builders', 'Heroes'];
const initialData = safeJsonForScript({ ...data, csrfToken, sessionBinding });

function safeSocialUrl(value: string | undefined): string | undefined {
  if (!value) return undefined;
  try {
    const parsed = new URL(value);
    return ['http:', 'https:'].includes(parsed.protocol) && !parsed.username && !parsed.password
      ? parsed.href.replace(/["<>]/g, (character) => encodeURIComponent(character))
      : undefined;
  } catch {
    return undefined;
  }
}
---

<div class="creator-owner" data-creator-owner data-owner-root data-csrf={csrfToken} data-session-binding={sessionBinding} data-public-origin={publicOrigin} data-profile-version={profile?.version}>
  <div class="creator-owner__account-bar">
    <a class="creator-owner__back" data-owner-navigation href="/" aria-label="Volver al sitio">Volver al sitio</a>
    <details class="creator-owner__account-menu">
      <summary aria-label="Abrir menú de cuenta">
        <img class="creator-owner__avatar" src={photoPath} alt="" width="36" height="36" data-owner-avatar hidden={!photoPath} />
        <span class="creator-owner__avatar creator-owner__avatar--initials" aria-hidden="true" data-owner-avatar-initial hidden={Boolean(photoPath)}>{profile?.displayName.slice(0, 1).toUpperCase() ?? accountEmail.slice(0, 1).toUpperCase()}</span>
        <span>Cuenta</span>
      </summary>
      <div class="creator-owner__account-popover">
        <p class="creator-owner__email">{accountEmail}</p>
        {isAdmin && <a href="/cuenta/administracion/">Administración</a>}
        <AccountLogout csrfToken={logoutCsrfToken} />
      </div>
    </details>
  </div>

  <main id="contenido" class="creator-owner__main site-container" tabindex="-1">
    <header class="creator-owner__page-heading">
      <p class="creator-owner__eyebrow">Espacio de creador</p>
      <h1>Tu página</h1>
      <p>Administra tu página y comparte su enlace cuando esté visible.</p>
    </header>

    <div class="creator-owner__status" data-owner-status role="status" aria-live="polite" hidden></div>
    <div class="creator-owner__status" data-session-recovery-shell hidden>
      <p data-session-recovery-status role="status" aria-live="polite" hidden></p>
      <a class="button button--outline" data-session-recovery-sign-in href="/cuenta/ingresar/" target="_blank" rel="noopener noreferrer" hidden>Ingresar en otra pestaña</a>
      <button class="button button--outline" type="button" data-session-recovery-check hidden>Comprobar sesión</button>
    </div>

    <section class="creator-owner__create" data-owner-create-panel hidden={Boolean(profile)} aria-labelledby="creator-owner-create-title">
      <p class="creator-owner__eyebrow">Primer paso</p>
      <h2 id="creator-owner-create-title">Prepara tu página</h2>
      <p>El nombre y la dirección se pueden elegir por separado. Al crearla queda como borrador; publicar es una acción posterior.</p>
      <form class="creator-owner__form" data-owner-form="crear">
        <div class="creator-owner__field">
          <label for="owner-create-name">Nombre visible</label>
          <input id="owner-create-name" name="displayName" autocomplete="name" maxlength="120" required />
        </div>
        <div class="creator-owner__field">
          <label for="owner-create-slug">Dirección de tu página</label>
          <div class="creator-owner__slug-field"><span aria-hidden="true">/c/</span><input id="owner-create-slug" name="slug" required minlength="3" maxlength="40" pattern="[a-z0-9]+(-[a-z0-9]+)*" autocomplete="off" autocapitalize="none" spellcheck="false" /></div>
          <small>3–40 caracteres: minúsculas, números y guiones sencillos.</small>
        </div>
        <button class="button button--dark" type="submit">Crear borrador</button>
        <p class="creator-owner__status" data-owner-create-status role="status" aria-live="polite"></p>
        <section class="creator-owner__conflict" data-owner-conflict hidden aria-labelledby="owner-create-conflict-title"><h3 id="owner-create-conflict-title">La página cambió</h3><p data-owner-conflict-copy>Otra pestaña pudo crear la página mientras editabas. Compara los datos guardados antes de elegir cómo seguir.</p><button class="button button--outline" type="button" data-owner-compare>Comparar con lo guardado</button><div data-owner-comparison hidden></div><button class="button button--outline" type="button" data-owner-adopt hidden>Usar la versión guardada</button></section>
      </form>
    </section>

    {!profile && view === 'solicitudes' && <section class="creator-owner__claims creator-owner__claims-preparation" aria-labelledby="owner-claims-preparation-title">
      <p class="creator-owner__eyebrow">Solicitudes</p>
      <h2 id="owner-claims-preparation-title">Prepara tu página para solicitar edición</h2>
      <p>Las solicitudes de edición se gestionan desde Tu página. Primero crea el borrador de tu perfil.</p>
      <a class="button button--dark" href="#owner-create-name">Ir al formulario de borrador</a>
    </section>}

    {!profile && view === 'estadisticas' && statistics?.state === 'invalid-query' ? (
      <CreatorStatistics result={statistics} />
    ) : !profile ? (
      <CreatorOwnerActivity profile={null} initialPeriod={initialStatisticsPeriod} />
    ) : null}

    <div class="creator-owner__profile" data-owner-profile hidden={!profile}>
      <section class="creator-owner__identity" aria-labelledby="owner-profile-name">
        <div class="creator-owner__identity-heading">
          <img class="creator-owner__photo" src={photoPath} alt="Foto de perfil" width="96" height="96" data-owner-photo hidden={!photoPath} />
          <div class="creator-owner__photo creator-owner__photo--placeholder" aria-hidden="true" data-owner-photo-placeholder hidden={Boolean(photoPath)}>{profile?.displayName.slice(0, 1).toUpperCase() ?? ''}</div>
          <div class="creator-owner__identity-copy">
            <p class="creator-owner__eyebrow">Identidad pública</p>
            <h2 id="owner-profile-name" data-owner-name>{profile?.displayName}</h2>
            <p class="creator-owner__slug" data-owner-slug>{canonicalPath}</p>
            <span class="creator-owner__badge" data-owner-state hidden={!profile || (profile.published && !profile.hidden)}>{profile?.hidden ? 'Oculta' : 'Borrador'}</span>
          </div>
        </div>
        <div class="creator-owner__profile-actions">
          <button class="button button--outline" type="button" data-owner-edit="datos">Editar datos</button>
          <button class="button button--outline" type="button" data-owner-edit="redes">Editar redes</button>
          <button class="button button--outline" type="button" data-owner-edit="foto">Editar foto</button>
        </div>
        <p class="creator-owner__status" data-owner-profile-status role="status" aria-live="polite"></p>
      </section>

      <section class="creator-owner__public" aria-label="Página pública" data-owner-public>
        <p data-owner-public-copy hidden={!profile?.published || profile.hidden}>Tu página está publicada y visible.</p>
        <p data-owner-hidden-copy hidden={!profile?.hidden}>La página está oculta por administración. Puedes editar tus datos; sólo administración puede cambiar su visibilidad.</p>
        <p data-owner-draft-copy hidden={!profile || profile.published}>Tu página está en borrador. Puedes completar el perfil y publicarla cuando esté lista.</p>
        {profile?.published && !profile.hidden && <>
          <a class="button button--outline" data-owner-public-link href={canonicalUrl} target="_blank" rel="noopener noreferrer" aria-label="Ver página pública (abre en otra pestaña)">Ver página pública <span aria-hidden="true">↗</span></a>
          <button class="button button--outline" type="button" data-owner-copy data-url={canonicalUrl}>Copiar enlace</button>
        </>}
        {profile && !profile.published && !profile.hidden && <button class="button button--dark" type="button" data-owner-publish>Publicar página</button>}
        <button class="button button--outline" type="button" data-owner-publish-check hidden>Comprobar estado guardado</button>
        <p class="creator-owner__status" data-owner-copy-status role="status" aria-live="polite"></p>
      </section>

      {profile && (view === 'enlaces' || view === 'series') && <CreatorOwnerActivity profile={profile} />}
      <nav class="creator-owner__link-tools" aria-label="Secciones de Tu página">
        <a class="button button--outline" data-owner-navigation aria-current={view === 'enlaces' ? 'page' : undefined} href="/cuenta/?vista=enlaces">Enlaces</a>
        <a class="button button--outline" data-owner-navigation aria-current={view === 'series' ? 'page' : undefined} href="/cuenta/?vista=series">Series</a>
        <a class="button button--outline" data-owner-navigation aria-current={view === 'estadisticas' ? 'page' : undefined} href="/cuenta/?vista=estadisticas&amp;periodo=30&amp;pagina=1">Estadísticas</a>
        <a class="button button--outline" data-owner-navigation aria-current={view === 'solicitudes' ? 'page' : undefined} href="/cuenta/?vista=solicitudes">Solicitudes</a>
      </nav>
      {view === 'enlaces' && <CreatorOwnerLinks data={data} query={linksQuery} queryError={linksQueryError} />}
      {view === 'series' && <CreatorOwnerSeries data={data} query={seriesQuery} queryError={seriesQueryError} />}
      {view === 'solicitudes' && <CreatorOwnerClaims data={data} />}
      {profile && view === 'estadisticas' && (
        statistics && statistics.state !== 'no-profile' && statistics.state !== 'not-published'
          ? <CreatorStatistics result={statistics} />
          : <CreatorOwnerActivity profile={profile} initialPeriod={initialStatisticsPeriod} />
      )}

      <section class="creator-owner__details" aria-labelledby="owner-details-title">
        <div class="creator-owner__section-heading">
          <div>
            <p class="creator-owner__eyebrow">Tu identidad</p>
            <h2 id="owner-details-title">Sobre ti</h2>
          </div>
        </div>
        <dl class="creator-owner__facts">
          <div><dt>Ubicación</dt><dd data-owner-location>{[profile?.city, profile?.country].filter(Boolean).join(', ') || 'Sin ubicación agregada'}</dd></div>
          <div><dt>Programas de AWS</dt><dd data-owner-programs>{profile?.programs.length ? profile.programs.join(', ') : 'Sin programas agregados'}</dd></div>
        </dl>
        <p class="creator-owner__bio" data-owner-bio>{profile?.bio || 'Agrega una presentación breve para contar quién eres.'}</p>
      </section>

      <section class="creator-owner__socials" aria-labelledby="owner-socials-title">
        <div class="creator-owner__section-heading">
          <div>
            <p class="creator-owner__eyebrow">Dónde encontrarte</p>
            <h2 id="owner-socials-title">Redes y sitio web</h2>
          </div>
        </div>
        <ul data-owner-social-list>
          {socials.map(({ key, label }) => (
            <li data-owner-social={key} hidden={!safeSocialUrl(profile?.socials[key])}><a href={safeSocialUrl(profile?.socials[key])} target="_blank" rel="noopener noreferrer"><span data-owner-social-label>{label}</span><span class="creator-owner__social-url" data-owner-social-url>{safeSocialUrl(profile?.socials[key])}</span></a></li>
          ))}
        </ul>
        <p class="creator-owner__empty" data-owner-no-socials hidden={Boolean(profile && socials.some(({ key }) => safeSocialUrl(profile.socials[key])))}>Aún no agregaste redes o enlaces externos.</p>
      </section>

    </div>

    <dialog class="creator-owner__dialog" data-owner-dialog aria-labelledby="creator-owner-dialog-title">
      <div class="creator-owner__dialog-panel">
        <header class="creator-owner__dialog-heading">
          <div>
            <p class="creator-owner__eyebrow">Tu página</p>
            <h2 id="creator-owner-dialog-title" data-owner-dialog-title>Editar datos</h2>
          </div>
          <button class="creator-owner__close" type="button" data-owner-close aria-label="Cerrar edición">×</button>
        </header>

        <div class="creator-owner__status" data-session-recovery-shell hidden>
          <p data-session-recovery-status role="status" aria-live="polite" hidden></p>
          <a class="button button--outline" data-session-recovery-sign-in href="/cuenta/ingresar/" target="_blank" rel="noopener noreferrer" hidden>Ingresar en otra pestaña</a>
          <button class="button button--outline" type="button" data-session-recovery-check hidden>Comprobar sesión</button>
        </div>

        <form class="creator-owner__form" data-owner-form="datos" hidden>
          <div class="creator-owner__field"><label for="owner-display-name">Nombre visible</label><input id="owner-display-name" name="displayName" autocomplete="name" maxlength="120" required /></div>
          <div class="creator-owner__field"><label for="owner-slug">Dirección de tu página</label><div class="creator-owner__slug-field"><span aria-hidden="true">/c/</span><input id="owner-slug" name="slug" required minlength="3" maxlength="40" pattern="[a-z0-9]+(-[a-z0-9]+)*" autocomplete="off" autocapitalize="none" spellcheck="false" /></div><small>3–40 caracteres: minúsculas, números y guiones sencillos. Cambiarla conserva la dirección anterior como alias.</small></div>
          <div class="creator-owner__field"><label for="owner-city">Ciudad <span>(opcional)</span></label><input id="owner-city" name="city" autocomplete="address-level2" maxlength="100" /></div>
          <div class="creator-owner__field"><label for="owner-country">País <span>(opcional)</span></label><input id="owner-country" name="country" autocomplete="country-name" maxlength="100" /></div>
          <fieldset class="creator-owner__field creator-owner__programs"><legend>Programas de AWS <span>(opcional)</span></legend>
            {programs.map((program) => <label for={`owner-program-${program.toLowerCase().replaceAll(' ', '-')}`}><input id={`owner-program-${program.toLowerCase().replaceAll(' ', '-')}`} type="checkbox" name="programs" value={program} /><span>{program}</span></label>)}
          </fieldset>
          <div class="creator-owner__field"><label for="owner-bio">Sobre ti <span>(opcional)</span></label><textarea id="owner-bio" name="bio" rows="5" maxlength="2000"></textarea><small>Hasta 2000 caracteres.</small></div>
          <input name="version" type="hidden" />
          <div class="creator-owner__dialog-actions"><button class="button button--dark" type="submit">Guardar datos</button><button class="button button--outline" type="button" data-owner-cancel>Cancelar</button></div>
          <p class="creator-owner__status" data-owner-form-status="datos" role="status" aria-live="polite"></p>
          <section class="creator-owner__conflict" data-owner-conflict hidden aria-labelledby="owner-conflict-title"><h3 id="owner-conflict-title">El perfil cambió</h3><p data-owner-conflict-copy></p><button class="button button--outline" type="button" data-owner-compare>Comparar con lo guardado</button><div data-owner-comparison hidden></div><button class="button button--outline" type="button" data-owner-adopt hidden>Usar la versión guardada</button></section>
        </form>

        <form class="creator-owner__form" data-owner-form="redes" hidden>
          <p>Las direcciones deben ser URL HTTP o HTTPS completas. Deja un campo vacío para quitar esa red.</p>
          {socials.map(({ key, label }) => <div class="creator-owner__field"><label for={`owner-social-${key}`}>{label}</label><input id={`owner-social-${key}`} name={`social-${key}`} type="url" inputmode="url" autocomplete="url" placeholder="https://" maxlength="500" /></div>)}
          <input name="version" type="hidden" />
          <div class="creator-owner__dialog-actions"><button class="button button--dark" type="submit">Guardar redes</button><button class="button button--outline" type="button" data-owner-cancel>Cancelar</button></div>
          <p class="creator-owner__status" data-owner-form-status="redes" role="status" aria-live="polite"></p>
          <section class="creator-owner__conflict" data-owner-conflict hidden aria-labelledby="owner-social-conflict-title"><h3 id="owner-social-conflict-title">El perfil cambió</h3><p data-owner-conflict-copy></p><button class="button button--outline" type="button" data-owner-compare>Comparar con lo guardado</button><div data-owner-comparison hidden></div><button class="button button--outline" type="button" data-owner-adopt hidden>Usar la versión guardada</button></section>
        </form>

        <form class="creator-owner__form" data-owner-form="foto" hidden>
          <p>JPEG, PNG o WebP; hasta 15 MiB y 40 megapíxeles. La foto se guarda sólo cuando termina la carga.</p>
          <img class="creator-owner__photo creator-owner__photo--preview" src={photoPath} alt="Foto actual del perfil" width="112" height="112" data-owner-photo-preview hidden={!photoPath} />
          <div class="creator-owner__field"><label for="owner-photo-file">Elegir una foto</label><input id="owner-photo-file" name="photo" type="file" accept="image/jpeg,image/png,image/webp" required data-busy-control /></div>
          <div class="creator-owner__dialog-actions"><button class="button button--dark" type="submit">Subir y guardar foto</button><button class="button button--outline" type="button" data-owner-cancel>Cancelar</button></div>
          <p class="creator-owner__status" data-owner-form-status="foto" role="status" aria-live="polite"></p>
          <button class="button button--outline" type="button" data-owner-check-photo hidden>Comprobar qué foto quedó activa</button>
        </form>

        <form class="creator-owner__form" data-owner-form="enlace" data-link-edit-form hidden>
          <fieldset class="creator-owner__field creator-owner__link-fields" data-link-metadata-fields>
            <legend>Ficha del contenido</legend>
            <details class="creator-owner__link-help"><summary>Sobre esta ficha</summary><p>El título, la URL y la descripción actualizan la ficha del catálogo; otros creadores que la referencien también verán esos cambios.</p></details>
            <div class="creator-owner__field"><label for="owner-link-title">Título</label><input id="owner-link-title" name="title" maxlength="200" required /></div>
            <div class="creator-owner__field"><label for="owner-link-url">URL</label><input id="owner-link-url" name="url" type="url" inputmode="url" maxlength="2048" required /></div>
            <div class="creator-owner__field"><label for="owner-link-description">Descripción <span>(opcional)</span></label><textarea id="owner-link-description" name="description" rows="4" maxlength="2000"></textarea></div>
          </fieldset>
          <fieldset class="creator-owner__field creator-owner__link-fields" data-link-options>
            <legend>Opciones de tu página</legend>
            <label><input type="checkbox" name="featured" /><span>Destacar en tu página</span></label>
            <label><input type="checkbox" name="selectedForDirectory" /><span>Proponer al directorio</span></label>
            <details class="creator-owner__link-help"><summary>Sobre el directorio</summary><p>La propuesta requiere aprobación. Quitarla no quita el enlace de tu página; la actualización del directorio puede demorar.</p></details>
          </fieldset>
          <p class="creator-owner__status" data-owner-form-status="enlace" role="status" aria-live="polite"></p>
          <section class="creator-owner__conflict" data-owner-conflict data-link-conflict hidden aria-labelledby="owner-link-conflict-title">
            <h3 id="owner-link-conflict-title">El enlace cambió</h3>
            <p data-owner-conflict-copy></p>
            <button class="button button--outline" type="button" data-owner-compare>Comparar con lo guardado</button>
            <div data-owner-comparison hidden></div>
            <button class="button button--outline" type="button" data-owner-adopt hidden>Usar la versión guardada</button>
          </section>
          <div class="creator-owner__dialog-actions"><button class="button button--dark" type="submit">Guardar cambios</button><button class="button button--outline" type="button" data-owner-cancel>Cancelar</button></div>
        </form>

        <form class="creator-owner__form" data-owner-form="alta-enlace" data-link-add-form hidden>
          <p>Agrega una URL a tu página. La propuesta al directorio queda seleccionada inicialmente y puedes quitarla antes de guardar.</p>
          <div class="creator-owner__field"><label for="owner-add-link-title">Título</label><input id="owner-add-link-title" name="title" maxlength="200" required /></div>
          <div class="creator-owner__field"><label for="owner-add-link-url">URL</label><input id="owner-add-link-url" name="url" type="url" inputmode="url" maxlength="2048" required /></div>
          <div class="creator-owner__field"><label for="owner-add-link-description">Descripción <span>(opcional)</span></label><textarea id="owner-add-link-description" name="description" rows="4" maxlength="2000"></textarea></div>
          <label class="creator-owner__link-checkbox"><input type="checkbox" name="selectedForDirectory" checked /><span>Proponer al directorio</span></label>
          <details class="creator-owner__link-help"><summary>Sobre el directorio</summary><p>La propuesta requiere aprobación. Quitarla no quita el enlace de tu página; la actualización del directorio puede demorar.</p></details>
          <button class="button button--outline" type="button" data-link-add-options hidden>Revisar opciones del enlace compartido agregado</button>
          <p class="creator-owner__status" data-link-add-status role="status" aria-live="polite"></p>
          <div class="creator-owner__dialog-actions"><button class="button button--dark" type="submit">Agregar enlace</button><button class="button button--outline" type="button" data-owner-cancel>Cancelar</button></div>
        </form>

        <section class="creator-owner__catalog" data-owner-catalog hidden aria-label="Buscar contenido publicado">
          <form id="owner-catalog-search-form" class="creator-owner__catalog-search" method="get" data-catalog-search-form role="search">
            <div class="creator-owner__field">
              <label for="owner-catalog-search">Buscar por título o URL</label>
              <input id="owner-catalog-search" type="search" name="buscarCatalogo" data-catalog-search autocomplete="off" />
            </div>
            <button class="button button--outline" type="submit" data-catalog-search-submit>Buscar</button>
          </form>
          <p class="creator-owner__status" data-catalog-status role="status" aria-live="polite"></p>
          <button class="button button--outline" type="button" data-catalog-retry hidden>Reintentar carga del catálogo</button>
          <p data-catalog-count aria-live="polite" hidden>0 resultados</p>
          <ul class="creator-owner__catalog-results" data-catalog-results aria-label="Resultados del catálogo"></ul>
          <p class="creator-owner__empty" data-catalog-empty hidden>No hay recursos que coincidan con la búsqueda.</p>
          <p class="creator-owner__catalog-selected" data-catalog-selected-count aria-live="polite">Ningún recurso seleccionado.</p>
          <ul class="creator-owner__claim-selection" data-claim-selection hidden aria-label="Selección para solicitar edición"></ul>
          <nav class="creator-owner__catalog-pagination" aria-label="Páginas del catálogo">
            <button class="button button--outline" type="button" data-catalog-page="previous" disabled>Anterior</button>
            <span data-catalog-page-label aria-live="polite">Página 1 de 1</span>
            <button class="button button--outline" type="button" data-catalog-page="next" disabled>Siguiente</button>
          </nav>
          <form class="creator-owner__form creator-owner__catalog-reference" data-owner-form="referencia" data-catalog-reference-form method="get" hidden>
            <label class="creator-owner__link-checkbox creator-owner__catalog-directory">
              <input type="checkbox" name="selectedForDirectory" data-catalog-directory checked />
              <span>Proponer al directorio</span>
            </label>
            <details class="creator-owner__link-help"><summary>Sobre el directorio</summary><p>La propuesta requiere aprobación. Agregar una referencia no concede permiso para editar la ficha compartida.</p></details>
            <button class="button button--outline" type="button" data-catalog-correction-open hidden>Revisar opciones de esta colocación</button>
            <section class="creator-owner__conflict" data-owner-conflict data-catalog-conflict hidden aria-labelledby="owner-catalog-conflict-title">
              <h4 id="owner-catalog-conflict-title">Revisa el estado guardado</h4>
              <p data-owner-conflict-copy></p>
              <button class="button button--outline" type="button" data-owner-compare>Comparar con lo guardado</button>
              <div data-owner-comparison hidden></div>
              <button class="button button--outline" type="button" data-owner-adopt hidden>Usar la versión guardada</button>
            </section>
            <div class="creator-owner__dialog-actions">
              <button class="button button--dark" type="submit" data-catalog-reference disabled>Agregar a mi página</button>
              <button class="button button--outline" type="button" data-owner-cancel data-catalog-cancel>Cancelar</button>
            </div>
          </form>
          <form class="creator-owner__form creator-owner__claim-form" data-owner-form="reclamacion" data-claim-form hidden>
            <p>Selecciona contenido del catálogo y agrega las URLs conocidas que quieras solicitar. Enviar una solicitud no agrega contenido a tu página ni concede permiso para editar.</p>
            <div class="creator-owner__field">
              <label for="owner-claim-urls">URLs conocidas <span>(opcional, una por línea)</span></label>
              <textarea id="owner-claim-urls" name="knownUrls" rows="4" data-claim-urls autocomplete="url"></textarea>
            </div>
            <div class="creator-owner__field">
              <label for="owner-claim-evidence">Contexto privado <span>(opcional)</span></label>
              <textarea id="owner-claim-evidence" name="evidence" rows="3" maxlength="2000" data-claim-evidence></textarea>
              <small>Hasta 2000 caracteres. Sólo lo ven quienes gestionan esta solicitud.</small>
            </div>
            <p class="creator-owner__status" data-owner-form-status="reclamacion" data-claim-status role="status" aria-live="polite"></p>
            <button class="button button--outline" type="button" data-claim-check hidden>Comprobar solicitudes</button>
            <div class="creator-owner__dialog-actions">
              <button class="button button--dark" type="submit" data-claim-submit>Enviar solicitud</button>
              <button class="button button--outline" type="button" data-owner-cancel data-claim-cancel>Cancelar</button>
            </div>
          </form>
        </section>

        <form class="creator-owner__form" data-owner-form="mover-enlace" data-link-move-form hidden aria-label="Mover enlace a una posición">
          <p class="creator-owner__move-context" id="owner-link-move-context" data-link-move-context aria-live="polite"></p>
          <div class="creator-owner__field">
            <label for="owner-link-target-position">Posición dentro del grupo</label>
            <input id="owner-link-target-position" name="targetPosition" type="number" min="1" step="1" required inputmode="numeric" aria-describedby="owner-link-move-context" />
          </div>
          <p class="creator-owner__status" data-owner-form-status="mover-enlace" role="status" aria-live="polite"></p>
          <div data-link-move-suggestion-shell hidden>
            <button class="button button--outline" type="button" data-link-move-suggestion></button>
          </div>
          <section class="creator-owner__conflict" data-owner-conflict data-link-move-conflict hidden aria-labelledby="owner-link-move-conflict-title">
            <h3 id="owner-link-move-conflict-title">El orden cambió</h3>
            <p data-owner-conflict-copy></p>
            <button class="button button--outline" type="button" data-owner-compare>Comparar con el orden guardado</button>
            <div data-owner-comparison hidden></div>
            <button class="button button--outline" type="button" data-owner-adopt hidden>Usar las versiones guardadas</button>
          </section>
          <div class="creator-owner__dialog-actions"><button class="button button--dark" type="submit">Guardar posición</button><button class="button button--outline" type="button" data-owner-cancel>Cancelar</button></div>
        </form>

        <form class="creator-owner__form" data-owner-form="serie" data-series-form hidden>
          <p class="creator-owner__form-context" data-series-form-context></p>
          <div class="creator-owner__field"><label for="owner-series-name">Nombre de la serie</label><input id="owner-series-name" name="name" maxlength="120" required data-series-name-suggestion /></div>
          <div class="creator-owner__field"><label for="owner-series-slug">Dirección de la serie</label><div class="creator-owner__slug-field"><span aria-hidden="true">/series/</span><input id="owner-series-slug" name="slug" required minlength="3" maxlength="40" pattern="[a-z0-9]+(-[a-z0-9]+)*" autocomplete="off" autocapitalize="none" spellcheck="false" data-series-slug-suggestion /></div><small>3–40 caracteres: minúsculas, números y guiones sencillos.</small></div>
          <div class="creator-owner__field"><label for="owner-series-description">Descripción <span>(opcional)</span></label><textarea id="owner-series-description" name="description" rows="4" maxlength="2000"></textarea></div>
          <p class="creator-owner__status" data-owner-form-status="serie" role="status" aria-live="polite"></p>
          <section class="creator-owner__conflict" data-owner-conflict data-series-conflict hidden aria-labelledby="owner-series-conflict-title">
            <h3 id="owner-series-conflict-title">La serie cambió</h3><p data-owner-conflict-copy></p>
            <button class="button button--outline" type="button" data-owner-compare>Comparar con lo guardado</button>
            <div data-owner-comparison hidden></div>
            <button class="button button--outline" type="button" data-owner-adopt hidden>Usar la versión guardada</button>
          </section>
          <div class="creator-owner__dialog-actions"><button class="button button--dark" type="submit">Guardar serie</button><button class="button button--outline" type="button" data-owner-cancel>Cancelar</button></div>
        </form>

        <form class="creator-owner__form" data-owner-form="mover-capitulo" data-chapter-move-form hidden aria-label="Mover capítulo en la serie">
          <p id="owner-chapter-move-context" class="creator-owner__move-context" data-chapter-move-context aria-live="polite"></p>
          <div class="creator-owner__field"><label for="owner-chapter-target-position">Posición en esta serie</label><input id="owner-chapter-target-position" name="targetPosition" type="number" min="1" step="1" required inputmode="numeric" aria-describedby="owner-chapter-move-context" /></div>
          <p class="creator-owner__status" data-owner-form-status="mover-capitulo" role="status" aria-live="polite"></p>
          <div data-chapter-move-suggestion-shell hidden><button class="button button--outline" type="button" data-chapter-move-suggestion></button></div>
          <section class="creator-owner__conflict" data-owner-conflict data-chapter-move-conflict hidden aria-labelledby="owner-chapter-conflict-title">
            <h3 id="owner-chapter-conflict-title">El orden de capítulos cambió</h3><p data-owner-conflict-copy></p>
            <button class="button button--outline" type="button" data-owner-compare>Comparar con el orden guardado</button>
            <div data-owner-comparison hidden></div>
            <button class="button button--outline" type="button" data-owner-adopt hidden>Usar el orden guardado</button>
          </section>
          <div class="creator-owner__dialog-actions"><button class="button button--dark" type="submit">Guardar posición</button><button class="button button--outline" type="button" data-owner-cancel>Cancelar</button></div>
        </form>

        <div class="creator-owner__exit" data-owner-exit-prompt hidden role="alertdialog" aria-labelledby="owner-exit-title" aria-describedby="owner-exit-copy">
          <h3 id="owner-exit-title">Tienes cambios sin guardar</h3>
          <p id="owner-exit-copy">Puedes guardar, descartar esta corrección o seguir editando.</p>
          <div class="creator-owner__dialog-actions"><button class="button button--dark" type="button" data-owner-exit-save>Guardar y salir</button><button class="button button--outline" type="button" data-owner-exit-discard>Descartar cambios</button><button class="button button--outline" type="button" data-owner-exit-continue>Seguir editando</button></div>
        </div>
      </div>
    </dialog>

    <script type="application/json" id="creator-owner-data" set:html={initialData} />
  </main>
  <footer class="creator-owner__help"><a href="mailto:contact@dondeaprendoaws.com">¿Necesitas ayuda? Contacta al equipo.</a></footer>
</div>

<script>
  import '../scripts/creator-owner.ts';
  import '../scripts/creator-owner-activity.ts';
</script>
