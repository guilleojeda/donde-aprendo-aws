---
import '../styles/site.css';
import '../styles/fonts.css';
import deployment from '../../config/deployment.json';
import { contributorStructuredData } from '../lib/blog-metadata.mjs';
import type { BlogContributor } from '../lib/blog-metadata.mjs';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  publishedTimestamp?: string;
  modifiedTimestamp?: string;
  author?: BlogContributor;
  noindex?: boolean;
  nofollow?: boolean;
}

const {
  title = 'Dónde Aprendo AWS: recursos y comunidades en español',
  description = 'Encontrá cursos, videos, creadores y comunidades para aprender AWS en español. Explorá recorridos de aprendizaje y próximos eventos.',
  canonical,
  image,
  imageAlt,
  publishedTimestamp,
  modifiedTimestamp,
  author,
  noindex = false,
  nofollow = false,
} = Astro.props;

// Preview media must resolve on the owned host before the domain cutover.
const mediaOrigin = import.meta.env.PUBLIC_SITE_ORIGIN || `https://${deployment.branchName}.${deployment.appId}.amplifyapp.com`;
const productionBuild = import.meta.env.PUBLIC_PRODUCTION === 'true';
const robots = !productionBuild || noindex || nofollow
  ? `${productionBuild && !noindex ? 'index' : 'noindex'}, ${productionBuild && !nofollow ? 'follow' : 'nofollow'}`
  : undefined;
const imageUrl = new URL(image || '/assets/site-social.png', mediaOrigin).href;
const socialImageAlt = image
  ? imageAlt
  : '¿Dónde Aprendo AWS? Recursos y comunidades para aprender AWS en español. Cursos, videos, recorridos y eventos.';
if (!socialImageAlt?.trim()) throw new Error('A custom social image needs a descriptive imageAlt.');
const articleSchema = publishedTimestamp && canonical && imageUrl
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: publishedTimestamp,
      dateModified: modifiedTimestamp,
      author: author ? contributorStructuredData(author) : undefined,
      image: [imageUrl],
      mainEntityOfPage: canonical,
    }).replaceAll('<', '\\u003c')
  : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={publishedTimestamp ? 'article' : 'website'} />
    <meta property="og:site_name" content="¿Dónde Aprendo AWS?" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {publishedTimestamp && <meta property="article:published_time" content={publishedTimestamp} />}
    {modifiedTimestamp && <meta property="article:modified_time" content={modifiedTimestamp} />}
    <meta name="twitter:card" content="summary_large_image" />
    {canonical && <meta name="twitter:title" content={title} />}
    {canonical && <meta name="twitter:description" content={description} />}
    {canonical && <meta name="twitter:url" content={canonical} />}
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {articleSchema && <script type="application/ld+json" set:html={articleSchema} />}
    {productionBuild && <script is:inline src="/assets/analytics.js" defer />}
    <link rel="icon" type="image/png" href="/assets/site-favicon.png" sizes="120x120" />
    <link rel="preload" href="/assets/fonts/fira-sans/latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
