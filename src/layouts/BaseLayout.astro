---
import '../styles/site.css';
import deployment from '../../config/deployment.json';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  publishedTimestamp?: string;
}

const {
  title = '¿Dónde Aprendo AWS?',
  description = 'El más completo listado de contenido en Español acerca de AWS. Artículos, videos, blogs, cursos, podcasts, y más.',
  canonical,
  image,
  publishedTimestamp,
} = Astro.props;

// Preview media must resolve on the owned host before the domain cutover.
const mediaOrigin = import.meta.env.PUBLIC_SITE_ORIGIN || `https://${deployment.branchName}.${deployment.appId}.amplifyapp.com`;
const imageUrl = image ? new URL(image, mediaOrigin).href : undefined;
const articleSchema = publishedTimestamp && canonical && imageUrl
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: publishedTimestamp,
      image: [imageUrl],
      mainEntityOfPage: canonical,
    }).replaceAll('<', '\\u003c')
  : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {articleSchema && <script type="application/ld+json" set:html={articleSchema} />}
    <link rel="icon" type="image/png" href="/assets/site-favicon.png" sizes="120x120" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
